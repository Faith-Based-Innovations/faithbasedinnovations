<%- include('../partials/tw-head') -%>
<body class="fbi-site flex min-h-full flex-col bg-slate-50 text-slate-800 antialiased">
<%- include('../partials/tw-header') -%>
<main class="flex-1">
  <%- include('../partials/tw-hero-premium', {
    heroEyebrow: 'Faith Based Innovations',
    heroTitle: 'Serious desktop software for work that matters.',
    heroLead: '<strong class="font-semibold text-white">Separate products. Shared principles.</strong> <strong class="font-semibold text-white">Sentinel</strong>, <strong class="font-semibold text-white">CFO</strong>, <strong class="font-semibold text-white">Eden</strong>, and <strong class="font-semibold text-white">Ledger</strong> are focused applications on <strong class="font-semibold text-white">your machine</strong>. <strong class="font-semibold text-white">' + SITE.steward.name + '</strong> is the shared local guidance layer that connects them through permission-aware workflows.',
    heroSplit: true,
    heroMockup: 'suite',
    heroActionsHtml: '<a href="products.html" class="fbi-btn fbi-btn--gold">Explore the ecosystem</a><a href="compare.html" class="fbi-btn fbi-btn--ghost">Compare products</a>'
  }) -%>

  <%- include('../partials/tw-wow-centerpiece') -%>

  <section class="fbi-section-overlap border-b border-slate-200/80 bg-white">
    <div class="mx-auto max-w-7xl px-4 py-20 sm:px-6 sm:py-28 lg:px-8">
      <p class="fbi-statement-mega fbi-statement-mega--gold text-center">Local-first means local-first.</p>
      <div class="mx-auto mt-16 max-w-3xl text-center">
        <p class="fbi-kicker text-faithGold">Philosophy</p>
        <h2 class="fbi-section-title fbi-section-title--lg mt-3">Built around ownership, not feeds</h2>
        <p class="fbi-section-lead mx-auto">Local-first by conviction. Privacy as default. <%= SITE.steward.name %> as a shared rules-based guidance layer inside each product, not open-ended generation.</p>
      </div>
      <div class="fbi-philosophy-grid fbi-card-depth mt-14">
        <div class="fbi-philosophy-item fbi-glow-blue">
          <div class="fbi-philosophy-item__media">
            <img src="./assets/philosophy/machine-first.png" alt="Desktop workstation representing local device ownership and on-machine control" width="560" height="420" loading="lazy" decoding="async" class="fbi-philosophy-item__img">
          </div>
          <h3 class="text-lg font-bold text-navy">Your machine first</h3>
          <p class="mt-2 text-sm leading-relaxed text-slate-600">Work stays on your device. Sync is optional and explicit, never assumed.</p>
        </div>
        <div class="fbi-philosophy-item fbi-glow-gold lg:translate-y-2">
          <div class="fbi-philosophy-item__media">
            <img src="./assets/philosophy/product-boundaries.png" alt="Modular product panels representing separate purpose-built software surfaces" width="560" height="420" loading="lazy" decoding="async" class="fbi-philosophy-item__img">
          </div>
          <h3 class="text-lg font-bold text-navy">Clear product boundaries</h3>
          <p class="mt-2 text-sm leading-relaxed text-slate-600">Evidence, finance, research, and identity each get a purpose-built surface.</p>
        </div>
        <div class="fbi-philosophy-item fbi-glow-blue">
          <div class="fbi-philosophy-item__media">
            <img src="./assets/philosophy/traceable-intelligence.png" alt="Structured data flow and rules engine diagram representing traceable intelligence" width="560" height="420" loading="lazy" decoding="async" class="fbi-philosophy-item__img">
          </div>
          <h3 class="text-lg font-bold text-navy">Traceable intelligence</h3>
          <p class="mt-2 text-sm leading-relaxed text-slate-600"><%= SITE.steward.name %> surfaces patterns from structured inputs you control. No invented filler.</p>
        </div>
      </div>
    </div>
    <div class="fbi-divider-glow fbi-divider-glow--light mx-auto mb-0 max-w-4xl" aria-hidden="true"></div>
  </section>

  <section class="fbi-ambient fbi-ambient--light fbi-ambient--shift">
    <div class="fbi-ambient__inner mx-auto max-w-7xl px-4 py-20 sm:px-6 sm:py-28 lg:px-8">
      <div class="mb-14 flex flex-col gap-6 lg:flex-row lg:items-end lg:justify-between">
        <div class="max-w-2xl">
          <p class="fbi-kicker text-faithGold">Focused applications</p>
          <h2 class="fbi-section-title fbi-section-title--lg mt-3"><%= SITE.suiteSectionTitle %></h2>
          <p class="fbi-section-lead">Each title is a separate focused application with its own domain. Steward gives them a consistent interaction model without merging data or missions.</p>
        </div>
        <a href="products.html" class="fbi-btn inline-flex min-h-[3rem] shrink-0 self-start rounded-full border border-slate-300/90 bg-white px-7 text-sm text-navy shadow-fbi-sm hover:border-faithGold hover:text-faithGold lg:self-end" style="box-shadow: var(--fbi-shadow-float);">View all products</a>
      </div>
      <div class="fbi-bento">
        <%- include('../partials/tw-ecosystem-card', { productId: 'sentinel' }) %>
        <%- include('../partials/tw-ecosystem-card', { productId: 'cfo' }) %>
        <%- include('../partials/tw-ecosystem-card', { productId: 'eden' }) %>
        <%- include('../partials/tw-ecosystem-card', { productId: 'ledger' }) %>
      </div>
    </div>
  </section>

  <section class="fbi-feature-band fbi-grid-bg">
    <div class="mx-auto max-w-7xl px-4 py-20 sm:px-6 sm:py-28 lg:px-8">
      <div class="fbi-split-section fbi-split-section--wide-right">
        <div>
          <p class="fbi-kicker text-slate-500">Architecture</p>
          <h2 class="fbi-section-title fbi-section-title--lg mt-3">Local-first by design</h2>
          <p class="fbi-section-lead">Encrypted vaults where it matters. <%= SITE.steward.name %> reads structured data you entered inside each application. Optional sync only when you choose it.</p>
          <p class="fbi-statement-mega mt-10 text-[clamp(1.5rem,4vw,2.25rem)]">Your data stays yours.</p>
          <ul class="mt-8 space-y-3 text-sm text-slate-600">
            <li class="flex gap-3"><span class="mt-2 h-1.5 w-1.5 shrink-0 rounded-full bg-faithGold"></span>Device-native storage and workflows</li>
            <li class="flex gap-3"><span class="mt-2 h-1.5 w-1.5 shrink-0 rounded-full bg-navy"></span>Rules-based guidance tied to your records</li>
            <li class="flex gap-3"><span class="mt-2 h-1.5 w-1.5 shrink-0 rounded-full bg-navy"></span>No engagement loops or surveillance growth models</li>
          </ul>
        </div>
        <%- include('../partials/tw-flow-visual', {
          flowTitle: 'How your data moves',
          flowLead: 'Work stays on your device first. Steward reads what you structured; sync is optional and user-controlled.'
        }) %>
      </div>
    </div>
  </section>

  <section class="border-y border-slate-200 bg-gradient-to-b from-white via-slate-50/50 to-white">
    <div class="mx-auto max-w-7xl px-4 py-20 sm:px-6 sm:py-28 lg:px-8">
      <div class="fbi-split-section">
        <div class="order-2 lg:order-1">
          <%- include('../partials/tw-ui-mockup', { mockupType: 'steward', mockupDark: false, mockupPremium: true }) %>
        </div>
        <div class="order-1 max-w-xl lg:order-2">
          <p class="fbi-kicker text-faithGold"><%= SITE.steward.name %></p>
          <h2 class="fbi-section-title fbi-section-title--lg mt-3">Shared guidance, not a super-app</h2>
          <p class="fbi-section-lead"><%= SITE.steward.homeBlurb %></p>
          <ul class="mt-8 space-y-3 text-sm text-slate-600">
            <% SITE.steward.traits.forEach(function (trait) { %>
            <li class="flex gap-3"><span class="mt-2 h-1.5 w-1.5 shrink-0 rounded-full bg-faithGold"></span><%= trait %></li>
            <% }); %>
          </ul>
          <blockquote class="fbi-statement mt-8">Deterministic, auditable, and tied to what you entered. <%= SITE.steward.name %> is designed to organize and surface, not to invent or override you.</blockquote>
          <a href="products.html" class="fbi-link-premium mt-8 inline-flex text-sm text-navy hover:text-faithGold">See how <%= SITE.steward.name %> fits each product →</a>
        </div>
      </div>
    </div>
  </section>

  <section class="fbi-security-band">
    <div class="fbi-security-band__inner mx-auto max-w-7xl px-4 py-20 sm:px-6 sm:py-24 lg:px-8">
      <div class="fbi-split-section">
        <div class="max-w-xl">
          <p class="fbi-kicker text-amber-200/90">Security &amp; privacy</p>
          <h2 class="fbi-section-title fbi-section-title--lg mt-3 text-white">Posture built for serious work</h2>
          <p class="mt-5 text-lg leading-relaxed text-slate-300">Our products are designed around local control, encrypted storage where appropriate, and transparent behavior. We do not treat users as telemetry feeds.</p>
        </div>
        <div class="fbi-glass fbi-glass--dark rounded-2xl p-8 fbi-card-depth">
          <h3 class="text-sm font-bold uppercase tracking-[0.14em] text-slate-400">Designed to</h3>
          <ul class="mt-5 space-y-3 text-sm leading-relaxed text-slate-300">
            <li class="flex gap-3"><span class="mt-1.5 h-1.5 w-1.5 shrink-0 rounded-full bg-faithGold"></span>Keep sensitive workflows on your hardware</li>
            <li class="flex gap-3"><span class="mt-1.5 h-1.5 w-1.5 shrink-0 rounded-full bg-faithGold"></span>Make data boundaries explicit per product</li>
            <li class="flex gap-3"><span class="mt-1.5 h-1.5 w-1.5 shrink-0 rounded-full bg-faithGold"></span>Support review and accountability, not hype</li>
          </ul>
          <a href="security.html" class="fbi-btn fbi-btn--ghost mt-8 min-h-0 px-5 py-2.5 text-sm">Security overview</a>
        </div>
      </div>
    </div>
  </section>

  <section class="border-b border-slate-200/80 bg-white">
    <div class="mx-auto max-w-7xl px-4 py-20 sm:px-6 sm:py-28 lg:px-8">
      <div class="max-w-3xl">
        <p class="fbi-kicker text-slate-500">At a glance</p>
        <h2 class="fbi-section-title fbi-section-title--lg mt-3">Compare missions</h2>
        <p class="fbi-section-lead">Four separate focused applications, one standard of quality. Open the full comparison for detail.</p>
      </div>
      <div class="fbi-card-depth mt-14 grid gap-6 sm:grid-cols-2 lg:grid-cols-4 lg:gap-8">
        <div class="fbi-mission-card fbi-mission-card--featured lg:translate-y-2">
          <p class="text-xs font-bold uppercase tracking-wider text-slate-600">Sentinel</p>
          <p class="mt-3 text-sm font-semibold text-navy">Evidence intelligence</p>
          <p class="mt-2 text-sm leading-relaxed text-slate-600">Timelines, relationships, and review exports on your machine.</p>
        </div>
        <div class="fbi-mission-card">
          <p class="text-xs font-bold uppercase tracking-wider text-faithGold">CFO</p>
          <p class="mt-3 text-sm font-semibold text-navy">Financial operating system</p>
          <p class="mt-2 text-sm leading-relaxed text-slate-600">Planning, forecasting, and cash-flow clarity from your records.</p>
        </div>
        <div class="fbi-mission-card lg:-translate-y-1">
          <p class="text-xs font-bold uppercase tracking-wider text-faithGold">Eden</p>
          <p class="mt-3 text-sm font-semibold text-navy">Research intelligence</p>
          <p class="mt-2 text-sm leading-relaxed text-slate-600">Sources, claims, and citations in one disciplined workspace.</p>
        </div>
        <div class="fbi-mission-card">
          <p class="text-xs font-bold uppercase tracking-wider text-faithGold">Ledger</p>
          <p class="mt-3 text-sm font-semibold text-navy">Vault &amp; documents</p>
          <p class="mt-2 text-sm leading-relaxed text-slate-600">Encrypted storage and exact-fill forms. No invented field values.</p>
        </div>
      </div>
      <div class="mt-12 flex flex-wrap gap-4">
        <a href="compare.html" class="fbi-btn inline-flex rounded-full border border-slate-300/90 bg-white px-8 text-base text-navy shadow-fbi-sm hover:border-faithGold hover:text-faithGold" style="box-shadow: var(--fbi-shadow-float);">Open full comparison</a>
      </div>
    </div>
  </section>

  <section class="fbi-status-band" aria-label="Build status">
    <div class="mx-auto max-w-4xl px-4 py-16 text-center sm:px-6 sm:py-20 lg:px-8">
      <p class="text-xs font-bold uppercase tracking-[0.2em] text-amber-900"><%= SITE.availability.badge %></p>
      <h2 class="mt-4 text-2xl font-bold text-navy sm:text-3xl">Actively being built</h2>
      <p class="mt-4 text-base leading-relaxed text-slate-700"><%= SITE.availability.line %></p>
      <p class="mt-3 text-sm font-semibold text-amber-900" role="status"><%= PRODUCTS.sentinel.development.stage %> · Sentinel (as of <%= PRODUCTS.sentinel.development.asOf %>)</p>
      <p class="mt-2 text-sm text-slate-600"><%= SITE.availability.ctaLabel %></p>
    </div>
  </section>
</main>
<%- include('../partials/tw-footer') %>
<%- include('../partials/tw-scripts') %>
</body>
</html>
