<%- include('../partials/tw-head') -%>
<body class="fbi-site flex min-h-full flex-col bg-slate-50 text-slate-800 antialiased">
<%- include('../partials/tw-header') -%>
<main class="flex-1">
  <%- include('../partials/tw-hero-premium', {
    heroEyebrow: 'Premium desktop software',
    heroTitle: 'Purpose-built tools for faithful, disciplined work.',
    heroLead: 'We build <strong class="font-semibold text-white">Sentinel</strong>, <strong class="font-semibold text-white">CFO</strong>, <strong class="font-semibold text-white">Eden</strong>, and <strong class="font-semibold text-white">Ledger</strong>: separate apps that keep your work on <strong class="font-semibold text-white">your computer</strong>, treat privacy as the default, and use <strong class="font-semibold text-white">' + SITE.steward.name + '</strong> to apply clear rules to <em>your</em> data, not endless cloud feeds.',
    heroSplit: true,
    heroMockup: 'steward',
    heroActionsHtml: '<a href="products.html" class="inline-flex min-h-[3.25rem] items-center justify-center rounded-full bg-faithGold px-8 text-base font-semibold text-white shadow-xl shadow-amber-950/20 transition duration-280 ease-fbi-out hover:bg-amber-600 hover:shadow-fbi focus:outline-none focus-visible:ring-2 focus-visible:ring-amber-300 focus-visible:ring-offset-2 focus-visible:ring-offset-navy">Explore products</a><a href="compare.html" class="inline-flex min-h-[3.25rem] items-center justify-center rounded-full border border-white/25 bg-white/5 px-8 text-base font-semibold text-white backdrop-blur-sm transition duration-280 ease-fbi-out hover:border-white/40 hover:bg-white/15 focus:outline-none focus-visible:ring-2 focus-visible:ring-white/50 focus-visible:ring-offset-2 focus-visible:ring-offset-navy">Compare products</a>'
  }) -%>

  <section class="fbi-ambient fbi-ambient--light mx-auto max-w-7xl px-4 py-24 sm:px-6 sm:py-32 lg:px-8">
    <div class="fbi-ambient__inner">
      <div class="mb-16 max-w-3xl">
        <p class="fbi-kicker text-faithGold">Product line</p>
        <h2 class="fbi-section-title mt-3">Our products</h2>
        <p class="fbi-section-lead">Each title is engineered as standalone software: same standard of craft, clearly separated missions.</p>
      </div>
      <div class="fbi-stagger-grid grid gap-8 sm:grid-cols-2 lg:grid-cols-4 lg:gap-10">
        <% NAV_PRODUCTS.forEach(function (p) { %>
        <%- include('../partials/tw-product-card', { productId: p.id }) %>
        <% }); %>
      </div>
    </div>
  </section>

  <section class="fbi-feature-band fbi-grid-bg">
    <div class="mx-auto max-w-7xl px-4 py-24 sm:px-6 sm:py-32 lg:px-8">
      <div class="fbi-split-section fbi-split-section--wide-right">
        <div>
          <p class="fbi-kicker text-slate-500">Technical identity</p>
          <h2 class="fbi-section-title mt-3">Built for ownership on your machine</h2>
          <p class="fbi-section-lead">Local-first storage, encrypted vaults where it matters, and <%= SITE.steward.name %> as a rules-based layer over <em>your</em> structured data. Optional sync stays explicit, never assumed.</p>
          <blockquote class="fbi-statement mt-8">Serious work deserves software that does not treat you like a feed. Our products keep control, clarity, and traceability at the center.</blockquote>
        </div>
        <%- include('../partials/tw-tech-diagram', {
          diagramTitle: 'How your data moves',
          diagramLead: 'Work stays on your device first. Steward reads what you structured; sync is optional and user-controlled.'
        }) %>
      </div>
    </div>
  </section>

  <section class="border-y border-slate-200/70 bg-white">
    <div class="mx-auto max-w-7xl px-4 py-24 sm:px-6 sm:py-32 lg:px-8">
      <div class="max-w-3xl">
        <p class="fbi-kicker text-slate-500">At a glance</p>
        <h2 class="fbi-section-title mt-3">Compare missions</h2>
        <p class="mt-5 text-lg leading-relaxed text-slate-600">Four missions, one bar for quality. Use this view to see how scope differs, then open the full comparison for detail.</p>
      </div>
      <div class="mt-14 grid gap-6 sm:grid-cols-2 lg:grid-cols-4 lg:gap-8">
        <div class="fbi-card rounded-2xl border-2 border-slate-300/80 bg-slate-50/90 p-8 lg:translate-y-2">
          <p class="text-xs font-bold uppercase tracking-wider text-slate-600">Sentinel</p>
          <p class="mt-3 text-sm font-semibold text-navy">Evidence intelligence</p>
          <p class="mt-2 text-sm leading-relaxed text-slate-600">Organize complex evidence, timelines, and review materials on your machine, with <%= SITE.steward.name %> supporting structured investigative workflows.</p>
        </div>
        <div class="fbi-card rounded-2xl p-8">
          <p class="text-xs font-bold uppercase tracking-wider text-faithGold">CFO</p>
          <p class="mt-3 text-sm font-semibold text-navy">Financial operating system</p>
          <p class="mt-2 text-sm leading-relaxed text-slate-600">Money in motion: planning, forecasting, and cash-flow clarity, with <%= SITE.steward.name %> helping you read your own structured data, not endless feeds.</p>
        </div>
        <div class="fbi-card rounded-2xl p-8 lg:-translate-y-1">
          <p class="text-xs font-bold uppercase tracking-wider text-faithGold">Eden</p>
          <p class="mt-3 text-sm font-semibold text-navy">Research intelligence</p>
          <p class="mt-2 text-sm leading-relaxed text-slate-600">Gather sources, compare claims, and keep citations. <%= SITE.steward.name %> highlights what fits your question, separate from finance or identity tools.</p>
        </div>
        <div class="fbi-card rounded-2xl p-8">
          <p class="text-xs font-bold uppercase tracking-wider text-faithGold">Ledger</p>
          <p class="mt-3 text-sm font-semibold text-navy">Vault &amp; documents</p>
          <p class="mt-2 text-sm leading-relaxed text-slate-600">Encrypted storage for sensitive info and forms filled only from what you saved. <%= SITE.steward.name %> lines up fields; it never invents answers.</p>
        </div>
      </div>
      <div class="mt-14 rounded-3xl border border-slate-200/80 bg-gradient-to-br from-slate-50 to-white p-8 ring-1 ring-slate-900/[0.03] sm:p-10 fbi-glow-gold">
        <p class="text-sm font-bold uppercase tracking-[0.14em] text-slate-500">CFO vs. typical fintech apps</p>
        <p class="mt-4 text-base leading-relaxed text-slate-700">Most consumer apps optimize for engagement, cross-sell, and cloud-first sync. <strong class="font-semibold text-navy">CFO</strong> is built as deliberate desktop software: local-first, rules-based intelligence, and clarity over infinite feeds, because serious money work deserves a serious surface, not a marketing dashboard.</p>
      </div>
      <div class="mt-12">
        <a href="compare.html" class="inline-flex min-h-[3rem] items-center justify-center rounded-full border border-slate-300/90 bg-white px-8 text-base font-semibold text-navy shadow-fbi-sm transition duration-280 ease-fbi-out hover:border-faithGold hover:text-faithGold hover:shadow-fbi focus:outline-none focus-visible:ring-2 focus-visible:ring-faithGold">Open full comparison</a>
      </div>
    </div>
  </section>

  <%- include('../partials/tw-availability') %>
</main>
<%- include('../partials/tw-footer') %>
<%- include('../partials/tw-scripts') %>
</body>
</html>
