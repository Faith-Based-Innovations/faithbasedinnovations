<%- include('../partials/tw-head') -%>
<body class="fbi-site flex min-h-full flex-col bg-slate-50 text-slate-800 antialiased">
<%- include('../partials/tw-header') -%>
<main class="flex-1">
  <section class="relative overflow-hidden bg-slate-900 text-white">
    <div class="pointer-events-none absolute inset-0 bg-[linear-gradient(to_bottom,rgba(15,23,42,0.4),transparent_40%)]"></div>
    <div class="pointer-events-none absolute inset-0 opacity-[0.07] bg-[linear-gradient(to_right,rgba(255,255,255,0.08)_1px,transparent_1px),linear-gradient(to_bottom,rgba(255,255,255,0.08)_1px,transparent_1px)] bg-[length:32px_32px]"></div>
    <div class="relative mx-auto max-w-7xl px-4 py-16 sm:px-6 sm:py-20 lg:px-8">
      <div class="flex flex-wrap items-center gap-3">
        <span class="rounded-full border border-slate-500/80 bg-slate-800/80 px-3 py-1 text-xs font-semibold text-slate-200"><%= PRODUCTS.sentinel.statusBadge %></span>
        <span class="text-xs font-bold uppercase tracking-widest text-slate-400"><%= PRODUCTS.sentinel.tag %></span>
      </div>
      <p class="mt-6 text-sm font-medium uppercase tracking-[0.18em] text-slate-400">Local-first evidence intelligence</p>
      <h1 class="mt-3 max-w-4xl text-4xl font-extrabold tracking-tight sm:text-5xl lg:text-[3.25rem] lg:leading-[1.08]"><%= PRODUCTS.sentinel.headline %></h1>
      <p class="mt-6 max-w-3xl text-lg leading-relaxed text-slate-300"><%= PRODUCTS.sentinel.subhead %></p>
      <p class="mt-4 max-w-3xl text-base leading-relaxed text-slate-400">Organize complex evidence with structure and traceability. Built for investigative and review workflows—your evidence stays under your control.</p>
      <div class="mt-10 flex flex-wrap gap-3">
        <a href="#sentinel-development" class="inline-flex rounded-lg bg-faithGold px-5 py-2.5 text-sm font-semibold text-white transition duration-280 ease-fbi-out hover:bg-amber-600 focus:outline-none focus-visible:ring-2 focus-visible:ring-amber-300 focus-visible:ring-offset-2 focus-visible:ring-offset-slate-900">Development status</a>
        <a href="compare.html" class="inline-flex rounded-lg border border-slate-600 px-5 py-2.5 text-sm font-semibold text-white transition duration-280 ease-fbi-out hover:border-slate-500 hover:bg-white/5 focus:outline-none focus-visible:ring-2 focus-visible:ring-white/40">Compare products</a>
        <a href="products.html" class="inline-flex rounded-lg border border-slate-600 px-5 py-2.5 text-sm font-semibold text-white transition duration-280 ease-fbi-out hover:border-slate-500 hover:bg-white/5 focus:outline-none focus-visible:ring-2 focus-visible:ring-white/40">All products</a>
      </div>
    </div>
  </section>

  <section class="mx-auto max-w-3xl px-4 py-20 sm:px-6 lg:px-8">
    <h2 class="text-2xl font-bold text-navy">Evidence intelligence for human review</h2>
    <p class="mt-4 text-slate-600 leading-relaxed">Sentinel helps you ingest, organize, connect, review, summarize, visualize, and export large collections of evidence and related information in a structured, professional way. It is designed as a generalized evidence intelligence platform—capable of supporting legal workflows, investigations, compliance review, cybersecurity incidents, digital forensics, investigative journalism, internal and HR matters, insurance and business disputes, medical documentation review, advocacy, attorney preparation, and personal evidence organization.</p>
    <p class="mt-4 text-slate-600 leading-relaxed">The purpose is to organize and structure information for <strong class="text-navy">human review</strong>—not to replace judgment, counsel, or professional responsibility.</p>
  </section>

  <section class="border-y border-slate-200 bg-white py-16">
    <div class="mx-auto max-w-3xl px-4 sm:px-6 lg:px-8">
      <h2 class="text-center text-2xl font-bold text-navy">Core philosophy</h2>
      <ul class="mt-8 grid gap-4 sm:grid-cols-2">
        <li class="rounded-2xl border border-slate-200/90 bg-slate-50/60 px-4 py-3.5 text-sm text-slate-700 ring-1 ring-slate-900/[0.03]">Local-first architecture</li>
        <li class="rounded-2xl border border-slate-200/90 bg-slate-50/60 px-4 py-3.5 text-sm text-slate-700 ring-1 ring-slate-900/[0.03]">Privacy-focused workflows</li>
        <li class="rounded-2xl border border-slate-200/90 bg-slate-50/60 px-4 py-3.5 text-sm text-slate-700 ring-1 ring-slate-900/[0.03]">User-controlled data</li>
        <li class="rounded-2xl border border-slate-200/90 bg-slate-50/60 px-4 py-3.5 text-sm text-slate-700 ring-1 ring-slate-900/[0.03]">Structured evidence organization</li>
        <li class="rounded-2xl border border-slate-200/90 bg-slate-50/60 px-4 py-3.5 text-sm text-slate-700 ring-1 ring-slate-900/[0.03]">Traceable workflows</li>
        <li class="rounded-2xl border border-slate-200/90 bg-slate-50/60 px-4 py-3.5 text-sm text-slate-700 ring-1 ring-slate-900/[0.03]">Professional operational tooling</li>
      </ul>
    </div>
  </section>

  <section class="mx-auto max-w-3xl px-4 py-20 sm:px-6 lg:px-8">
    <div class="grid gap-12 lg:grid-cols-2">
      <div>
        <h2 class="text-xl font-bold text-navy">Sentinel is</h2>
        <ul class="mt-4 space-y-2 text-sm leading-relaxed text-slate-600">
          <li class="flex gap-2"><span class="text-faithGold">—</span>An investigative organization platform</li>
          <li class="flex gap-2"><span class="text-faithGold">—</span>An evidence intelligence workspace</li>
          <li class="flex gap-2"><span class="text-faithGold">—</span>A chronology and relationship-mapping system</li>
          <li class="flex gap-2"><span class="text-faithGold">—</span>An operational review environment</li>
          <li class="flex gap-2"><span class="text-faithGold">—</span>A structured export and reporting platform</li>
          <li class="flex gap-2"><span class="text-faithGold">—</span>A professional evidence preparation system</li>
        </ul>
      </div>
      <div>
        <h2 class="text-xl font-bold text-navy">Sentinel is not</h2>
        <ul class="mt-4 space-y-2 text-sm leading-relaxed text-slate-600">
          <li class="flex gap-2"><span class="text-slate-400">—</span>A law firm or legal advice</li>
          <li class="flex gap-2"><span class="text-slate-400">—</span>An attorney replacement or “AI lawyer”</li>
          <li class="flex gap-2"><span class="text-slate-400">—</span>A predictive legal engine</li>
          <li class="flex gap-2"><span class="text-slate-400">—</span>A cloud surveillance platform</li>
        </ul>
      </div>
    </div>
  </section>

  <section id="sentinel-capabilities" class="scroll-mt-28 border-y border-slate-200 bg-slate-50/50 py-16">
    <div class="mx-auto max-w-3xl px-4 sm:px-6 lg:px-8">
      <h2 class="text-center text-2xl font-bold text-navy">Platform capabilities</h2>
      <ul class="mt-8 space-y-3 text-slate-600">
        <li class="flex gap-3"><span class="mt-1.5 h-1.5 w-1.5 shrink-0 rounded-full bg-faithGold"></span>Evidence ingestion and preservation</li>
        <li class="flex gap-3"><span class="mt-1.5 h-1.5 w-1.5 shrink-0 rounded-full bg-faithGold"></span>Timeline generation and chronology analysis</li>
        <li class="flex gap-3"><span class="mt-1.5 h-1.5 w-1.5 shrink-0 rounded-full bg-faithGold"></span>Relationship mapping and recurring-pattern identification</li>
        <li class="flex gap-3"><span class="mt-1.5 h-1.5 w-1.5 shrink-0 rounded-full bg-faithGold"></span>Document categorization and authority/reference organization</li>
        <li class="flex gap-3"><span class="mt-1.5 h-1.5 w-1.5 shrink-0 rounded-full bg-faithGold"></span>Evidence summaries and visualization workflows</li>
        <li class="flex gap-3"><span class="mt-1.5 h-1.5 w-1.5 shrink-0 rounded-full bg-faithGold"></span>Structured exports, printable reports, and attorney-review packets</li>
        <li class="flex gap-3"><span class="mt-1.5 h-1.5 w-1.5 shrink-0 rounded-full bg-faithGold"></span>Evidence-linked reporting and audit-friendly workflows</li>
      </ul>
      <p class="mt-8 text-sm leading-relaxed text-slate-600">Imports and organization can include PDFs, images and screenshots, spreadsheets, exported message logs, research materials, audio and video references, documents, web references, and authority materials—with relationships preserved between evidence, events, entities, and chronology where possible.</p>
    </div>
  </section>

  <section class="mx-auto max-w-3xl px-4 py-20 sm:px-6 lg:px-8">
    <h2 class="text-2xl font-bold text-navy"><%= SITE.steward.name %> in Sentinel</h2>
    <p class="mt-4 text-slate-600 leading-relaxed"><strong class="text-navy"><%= SITE.steward.name %></strong> is the local rules-based assistant shared across Faith Based Innovations products—not marketed as generic “AI.” In Sentinel, Steward acts as an evidence organization assistant and investigative workflow layer on your machine.</p>
    <p class="mt-4 text-slate-600 leading-relaxed">Steward can help organize evidence, surface related information, support timeline construction, highlight recurring patterns, locate supporting material, assist with summaries, and help prepare structured review materials—always oriented to what you supplied, for your review.</p>
    <p class="mt-4 text-sm text-slate-500">Steward does not provide legal advice, guaranteed outcomes, automated legal conclusions, court predictions, or attorney replacement. Sentinel organizes information; professionals and users retain responsibility for conclusions and decisions.</p>
  </section>

  <section class="border-y border-slate-200 bg-white py-16">
    <div class="mx-auto max-w-3xl px-4 sm:px-6 lg:px-8">
      <h2 class="text-center text-2xl font-bold text-navy">Exports and review materials</h2>
      <p class="mt-4 text-center text-slate-600 leading-relaxed">Sentinel is built to produce professional, modern, organized outputs: attorney-review summaries, evidence summaries, timeline packets, structured reports, printable exports, and operational review materials—with Faith Based Innovations branding integrated subtly and professionally where appropriate.</p>
    </div>
  </section>

  <section id="sentinel-development" class="scroll-mt-28 mx-auto max-w-3xl px-4 py-20 sm:px-6 lg:px-8">
    <h2 class="text-2xl font-bold text-navy">Development status</h2>
    <p class="mt-4 text-slate-600 leading-relaxed"><%= PRODUCTS.sentinel.development.summary %></p>
    <p class="mt-4 text-slate-600 leading-relaxed">Current stage: <strong class="text-navy"><%= PRODUCTS.sentinel.development.stage %></strong> (as of <time datetime="2026-05-19"><%= PRODUCTS.sentinel.development.asOf %></time>). Active systems integration, operational workflow construction, and foundational export and report generation are underway.</p>
    <p class="mt-4 text-slate-600 leading-relaxed">Sentinel is not positioned as production complete, enterprise released, attorney-certified, legally authoritative, or feature finalized. The platform is actively evolving.</p>
    <h3 class="mt-10 text-lg font-semibold text-navy">Systems in active development</h3>
    <ul class="mt-4 space-y-2 text-sm text-slate-600">
      <li class="flex gap-3"><span class="mt-1.5 h-1.5 w-1.5 shrink-0 rounded-full bg-faithGold"></span>Evidence ingestion pipelines and structured indexing</li>
      <li class="flex gap-3"><span class="mt-1.5 h-1.5 w-1.5 shrink-0 rounded-full bg-faithGold"></span>Timeline generation and relationship mapping</li>
      <li class="flex gap-3"><span class="mt-1.5 h-1.5 w-1.5 shrink-0 rounded-full bg-faithGold"></span>Local-first storage and persistent case organization</li>
      <li class="flex gap-3"><span class="mt-1.5 h-1.5 w-1.5 shrink-0 rounded-full bg-faithGold"></span><%= SITE.steward.name %> contextual workflow integration</li>
      <li class="flex gap-3"><span class="mt-1.5 h-1.5 w-1.5 shrink-0 rounded-full bg-faithGold"></span>Structured export, visualization, and attorney-review packet workflows</li>
    </ul>
    <p class="mt-8 text-sm text-slate-500">Priorities: reliability, workflow cohesion, local-first architecture, export quality, traceability, and operational usability across investigative domains.</p>
  </section>

  <section class="bg-slate-900 py-14 text-white">
    <div class="mx-auto max-w-3xl px-4 text-center sm:px-6 lg:px-8">
      <h2 class="text-2xl font-bold">Faith Based Innovations ecosystem</h2>
      <p class="mt-4 text-slate-300 leading-relaxed"><strong class="text-white">Sentinel</strong> is evidence intelligence. <strong class="text-white">CFO</strong> is the financial operating system. <strong class="text-white">Eden</strong> is research software. <strong class="text-white">Ledger</strong> is identity and document execution—separate products, shared discipline and <%= SITE.steward.name %>.</p>
      <div class="mt-8 flex flex-wrap justify-center gap-3">
        <a href="product-cfo.html" class="rounded-lg border border-slate-600 px-4 py-2 text-sm font-semibold hover:bg-white/10">CFO</a>
        <a href="product-eden.html" class="rounded-lg border border-slate-600 px-4 py-2 text-sm font-semibold hover:bg-white/10">Eden</a>
        <a href="product-ledger.html" class="rounded-lg border border-slate-600 px-4 py-2 text-sm font-semibold hover:bg-white/10">Ledger</a>
        <a href="compare.html" class="rounded-lg bg-faithGold px-4 py-2 text-sm font-semibold text-navy hover:bg-amber-500">Compare all</a>
      </div>
    </div>
  </section>

  <%- include('../partials/tw-sentinel-availability') %>
</main>
<%- include('../partials/tw-footer') %>
<%- include('../partials/tw-scripts') %>
</body>
</html>
