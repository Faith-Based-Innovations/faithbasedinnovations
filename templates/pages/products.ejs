<%- include('../partials/tw-head') -%>
<body class="fbi-site flex min-h-full flex-col bg-slate-50 text-slate-800 antialiased">
<%- include('../partials/tw-header') -%>
<main class="flex-1">
  <%- include('../partials/tw-hero-premium', {
    heroEyebrow: 'Products',
    heroTitle: 'Sentinel, CFO, Eden, and Ledger',
    heroLead: 'Four standalone applications, each with its own job. One parent company, one standard of craft, and ' + SITE.steward.name + ' as the shared guide, without mashing evidence, finance, research, and identity into one messy super-app.',
    heroCompact: true
  }) -%>

  <section class="fbi-feature-band border-b border-slate-200/80">
    <div class="mx-auto max-w-7xl px-4 py-16 sm:px-6 lg:px-8">
      <div class="fbi-split-section">
        <div class="max-w-xl">
          <p class="fbi-kicker text-faithGold"><%= SITE.steward.name %></p>
          <h2 class="mt-3 text-3xl font-bold tracking-tight text-navy sm:text-4xl">Shared intelligence, separate missions</h2>
          <p class="mt-5 text-lg leading-relaxed text-slate-600"><%= SITE.steward.short %></p>
        </div>
        <%- include('../partials/tw-tech-diagram', {
          diagramTitle: 'One discipline, four surfaces',
          diagramLead: 'Each product keeps its own domain. Steward applies the same rules-based approach on top of structured data you control.'
        }) %>
      </div>
    </div>
  </section>

  <section class="fbi-ambient fbi-ambient--light mx-auto max-w-7xl px-4 pb-20 pt-16 sm:px-6 lg:px-8">
    <div class="fbi-ambient__inner fbi-stagger-grid grid gap-10 sm:grid-cols-2 lg:grid-cols-4">
      <% NAV_PRODUCTS.forEach(function (p) { %>
      <%- include('../partials/tw-product-card', { productId: p.id, cardLarge: true }) %>
      <% }); %>
    </div>
  </section>

  <section class="border-t border-slate-200 bg-white fbi-grid-bg">
    <div class="mx-auto max-w-7xl px-4 py-20 sm:px-6 lg:px-8">
      <div class="grid gap-12 lg:grid-cols-[1.1fr_0.9fr] lg:items-end">
        <div>
          <p class="fbi-kicker text-slate-500">Compare</p>
          <h2 class="mt-3 text-3xl font-bold tracking-tight text-navy sm:text-4xl">Compare at a glance</h2>
          <p class="mt-4 max-w-2xl text-lg leading-relaxed text-slate-600">See how Sentinel, CFO, Eden, and Ledger differ in core job, inputs, and <%= SITE.steward.name %>, plus how CFO contrasts with typical all-in-one fintech experiences.</p>
          <ul class="mt-8 space-y-3 text-sm text-slate-600">
            <li class="flex gap-3"><span class="mt-2 h-1.5 w-1.5 shrink-0 rounded-full bg-slate-500"></span><span><strong class="text-navy">Sentinel</strong>: evidence, timelines, review exports; not finance or identity.</span></li>
            <li class="flex gap-3"><span class="mt-2 h-1.5 w-1.5 shrink-0 rounded-full bg-faithGold"></span><span><strong class="text-navy">CFO</strong>: money, plans, projections; not research or identity.</span></li>
            <li class="flex gap-3"><span class="mt-2 h-1.5 w-1.5 shrink-0 rounded-full bg-faithGold"></span><span><strong class="text-navy">Eden</strong>: sources, claims, citations; not a finance dashboard.</span></li>
            <li class="flex gap-3"><span class="mt-2 h-1.5 w-1.5 shrink-0 rounded-full bg-faithGold"></span><span><strong class="text-navy">Ledger</strong>: secure vault and exact-fill documents; no invented field values.</span></li>
          </ul>
        </div>
        <a href="compare.html" class="inline-flex min-h-[3rem] shrink-0 items-center justify-center self-start rounded-full border border-slate-300/90 bg-white px-8 text-base font-semibold text-navy shadow-fbi-sm transition duration-280 ease-fbi-out hover:border-faithGold hover:text-faithGold hover:shadow-fbi focus:outline-none focus-visible:ring-2 focus-visible:ring-faithGold lg:self-end">Open comparison</a>
      </div>
    </div>
  </section>

  <%- include('../partials/tw-availability') %>
</main>
<%- include('../partials/tw-footer') %>
<%- include('../partials/tw-scripts') %>
</body>
</html>
