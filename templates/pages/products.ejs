<%- include('../partials/tw-head') -%>
<body class="fbi-site flex min-h-full flex-col bg-slate-50 text-slate-800 antialiased">
<%- include('../partials/tw-header') -%>
<main class="flex-1">
  <%- include('../partials/tw-hero-premium', {
    heroEyebrow: 'Product ecosystem',
    heroTitle: 'Four apps. One standard of craft.',
    heroLead: 'Sentinel, CFO, Eden, and Ledger are standalone desktop titles. ' + SITE.steward.name + ' is the shared local layer across each, without collapsing evidence, finance, research, and identity into one surface.',
    heroSplit: true,
    heroMockup: 'suite',
    heroActionsHtml: '<a href="compare.html" class="inline-flex min-h-[3rem] items-center justify-center rounded-full bg-faithGold px-7 text-sm font-semibold text-white hover:bg-amber-600 focus:outline-none focus-visible:ring-2 focus-visible:ring-amber-300 focus-visible:ring-offset-2 focus-visible:ring-offset-navy">Compare products</a>'
  }) -%>

  <section class="fbi-feature-band fbi-grid-bg border-b border-slate-200/80">
    <div class="mx-auto max-w-7xl px-4 py-16 sm:px-6 sm:py-20 lg:px-8">
      <div class="fbi-split-section">
        <div class="max-w-xl">
          <p class="fbi-kicker text-faithGold"><%= SITE.steward.name %></p>
          <h2 class="fbi-section-title mt-3">Shared intelligence, separate missions</h2>
          <p class="fbi-section-lead"><%= SITE.steward.short %></p>
        </div>
        <%- include('../partials/tw-tech-diagram', {
          diagramTitle: 'One discipline, four surfaces',
          diagramLead: 'Each product keeps its own domain. Steward applies the same rules-based approach on top of structured data you control.'
        }) %>
      </div>
    </div>
  </section>

  <section class="fbi-ambient fbi-ambient--light">
    <div class="fbi-ambient__inner mx-auto max-w-7xl px-4 py-16 sm:px-6 sm:py-24 lg:px-8">
      <div class="fbi-bento">
        <%- include('../partials/tw-ecosystem-card', { productId: 'sentinel' }) %>
        <%- include('../partials/tw-ecosystem-card', { productId: 'cfo' }) %>
        <%- include('../partials/tw-ecosystem-card', { productId: 'eden' }) %>
        <%- include('../partials/tw-ecosystem-card', { productId: 'ledger' }) %>
      </div>
    </div>
  </section>

  <section class="border-t border-slate-200 bg-white fbi-grid-bg">
    <div class="mx-auto max-w-7xl px-4 py-20 sm:px-6 lg:px-8">
      <div class="grid gap-12 lg:grid-cols-[1.1fr_0.9fr] lg:items-end">
        <div>
          <p class="fbi-kicker text-slate-500">Compare</p>
          <h2 class="fbi-section-title mt-3">Scope at a glance</h2>
          <p class="fbi-section-lead">See how Sentinel, CFO, Eden, and Ledger differ in core job, inputs, and <%= SITE.steward.name %>.</p>
          <ul class="mt-8 space-y-3 text-sm text-slate-600">
            <li class="flex gap-3"><span class="mt-2 h-1.5 w-1.5 shrink-0 rounded-full bg-slate-500"></span><strong class="text-navy">Sentinel</strong>: evidence, timelines, review exports</li>
            <li class="flex gap-3"><span class="mt-2 h-1.5 w-1.5 shrink-0 rounded-full bg-faithGold"></span><strong class="text-navy">CFO</strong>: money, plans, projections</li>
            <li class="flex gap-3"><span class="mt-2 h-1.5 w-1.5 shrink-0 rounded-full bg-faithGold"></span><strong class="text-navy">Eden</strong>: sources, claims, citations</li>
            <li class="flex gap-3"><span class="mt-2 h-1.5 w-1.5 shrink-0 rounded-full bg-faithGold"></span><strong class="text-navy">Ledger</strong>: vault and exact-fill documents</li>
          </ul>
        </div>
        <a href="compare.html" class="inline-flex min-h-[3rem] shrink-0 items-center justify-center self-start rounded-full border border-slate-300/90 bg-white px-8 text-base font-semibold text-navy shadow-fbi-sm transition duration-280 ease-fbi-out hover:border-faithGold hover:text-faithGold focus:outline-none focus-visible:ring-2 focus-visible:ring-faithGold lg:self-end">Open comparison</a>
      </div>
    </div>
  </section>

  <section class="fbi-status-band" aria-label="Build status">
    <div class="mx-auto max-w-4xl px-4 py-14 text-center sm:px-6 lg:px-8">
      <p class="text-xs font-bold uppercase tracking-[0.2em] text-amber-900"><%= SITE.availability.badge %></p>
      <p class="mt-4 text-base text-slate-700"><%= SITE.availability.line %></p>
    </div>
  </section>
</main>
<%- include('../partials/tw-footer') %>
<%- include('../partials/tw-scripts') %>
</body>
</html>
