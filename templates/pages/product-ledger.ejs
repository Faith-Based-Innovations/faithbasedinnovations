<%- include('../partials/tw-head') -%>
<body class="fbi-site flex min-h-full flex-col bg-slate-50 text-slate-800 antialiased">
<%- include('../partials/tw-header') -%>
<main class="flex-1">
  <%- include('../partials/tw-hero-premium', {
    heroBadge: PRODUCTS.ledger.tag,
    heroStatus: SITE.availability.badge,
    heroTitle: PRODUCTS.ledger.headline,
    heroLead: PRODUCTS.ledger.subhead,
    heroSplit: true,
    heroMockup: 'ledger',
    heroActionsHtml: '<a href="compare.html" class="inline-flex rounded-full bg-faithGold px-5 py-2.5 text-sm font-semibold text-white hover:bg-amber-600 focus:outline-none focus-visible:ring-2 focus-visible:ring-amber-300 focus-visible:ring-offset-2 focus-visible:ring-offset-navy">Compare products</a><a href="products.html" class="inline-flex rounded-full border border-white/25 px-5 py-2.5 text-sm font-semibold text-white hover:bg-white/10 focus:outline-none focus-visible:ring-2 focus-visible:ring-white/50">All products</a>'
  }) -%>

  <section class="fbi-feature-band fbi-grid-bg">
    <div class="mx-auto max-w-7xl px-4 py-20 sm:px-6 lg:px-8">
      <div class="fbi-split-section">
        <div class="max-w-xl">
          <p class="fbi-kicker text-faithGold">Vault first</p>
          <h2 class="fbi-section-title mt-3">Vault first, then documents filled exactly</h2>
          <p class="mt-5 text-lg leading-relaxed text-slate-600">Ledger is a local-first encrypted identity vault and deterministic document prefilling system, built for sensitive data and precise execution, not as a secondary tab inside another app.</p>
          <p class="mt-4 text-lg leading-relaxed text-slate-600">Store identity fields (including sensitive items such as a Social Security number if you choose), address and employment history, relationships, documents, and profiles for <strong class="text-navy">up to two people</strong>, for example spouses, all encrypted on your machine.</p>
        </div>
        <%- include('../partials/tw-tech-diagram', {
          diagramTitle: 'Encrypted, exact-fill workflow',
          diagramLead: 'Vault on your device. Steward maps fields to stored values. Missing data stays empty.'
        }) %>
      </div>
    </div>
  </section>

  <section class="border-y border-slate-200 bg-white py-20">
    <div class="mx-auto max-w-7xl px-4 sm:px-6 lg:px-8">
      <div class="fbi-split-section">
        <div class="fbi-card rounded-2xl p-8 text-center sm:text-left">
          <h2 class="text-2xl font-bold text-navy">People and references</h2>
          <p class="mt-4 text-slate-600 leading-relaxed">Track people you have known: relationship type, organization, role, relevance, and when you met.</p>
          <p class="mt-4 text-slate-600 leading-relaxed">Duration is calculated from <strong class="text-navy">local system time</strong>, so how long you have known someone stays accurate without manual edits.</p>
        </div>
        <div>
          <h2 class="text-2xl font-bold text-navy">Deterministic filling, never invented answers</h2>
          <p class="mt-4 text-slate-600 leading-relaxed">Ledger maps document fields to stored values and fills only exact matches. Missing data stays empty. Never guessed or inferred.</p>
          <blockquote class="fbi-statement mt-6"><strong class="text-navy"><%= SITE.steward.name %></strong> helps parse documents, map fields, and guide workflows. It does <em>not</em> generate answers you did not provide.</blockquote>
        </div>
      </div>
    </div>
  </section>

  <section class="fbi-feature-band fbi-feature-band--navy py-16">
    <div class="mx-auto max-w-3xl px-4 text-center sm:px-6 lg:px-8">
      <h2 class="text-2xl font-bold text-white sm:text-3xl">Alongside CFO and Eden</h2>
      <p class="mt-4 text-slate-200 leading-relaxed"><strong class="text-white">Ledger</strong> is a standalone vault application. <strong class="text-white">Sentinel</strong>, <strong class="text-white">CFO</strong>, and <strong class="text-white">Eden</strong> are separate focused applications. <%= SITE.steward.name %> is the shared local guidance layer across all four, without merging data or missions.</p>
      <div class="mt-8 flex flex-wrap justify-center gap-3">
        <a href="product-sentinel.html" class="rounded-lg border border-white/25 px-4 py-2 text-sm font-semibold hover:bg-white/10">Sentinel</a>
        <a href="product-cfo.html" class="rounded-lg border border-white/25 px-4 py-2 text-sm font-semibold hover:bg-white/10">CFO</a>
        <a href="product-eden.html" class="rounded-lg border border-white/25 px-4 py-2 text-sm font-semibold hover:bg-white/10">Eden</a>
        <a href="compare.html" class="rounded-lg bg-faithGold px-4 py-2 text-sm font-semibold text-navy hover:bg-amber-500">Compare all</a>
      </div>
    </div>
  </section>

  <%- include('../partials/tw-availability') %>
</main>
<%- include('../partials/tw-footer') %>
<%- include('../partials/tw-scripts') %>
</body>
</html>
