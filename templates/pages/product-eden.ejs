<%- include('../partials/tw-head') -%>
<body class="fbi-site flex min-h-full flex-col bg-slate-50 text-slate-800 antialiased">
<%- include('../partials/tw-header') -%>
<main class="flex-1">
  <%- include('../partials/tw-hero-premium', {
    heroBadge: PRODUCTS.eden.tag,
    heroStatus: SITE.availability.badge,
    heroTitle: PRODUCTS.eden.headline,
    heroLead: PRODUCTS.eden.subhead,
    heroSplit: true,
    heroMockup: 'eden',
    heroActionsHtml: '<a href="compare.html" class="inline-flex rounded-full bg-faithGold px-5 py-2.5 text-sm font-semibold text-white hover:bg-amber-600 focus:outline-none focus-visible:ring-2 focus-visible:ring-amber-300 focus-visible:ring-offset-2 focus-visible:ring-offset-navy">Compare products</a><a href="products.html" class="inline-flex rounded-full border border-white/25 px-5 py-2.5 text-sm font-semibold text-white hover:bg-white/10 focus:outline-none focus-visible:ring-2 focus-visible:ring-white/50">All products</a>'
  }) -%>

  <section class="fbi-feature-band fbi-grid-bg">
    <div class="mx-auto max-w-7xl px-4 py-20 sm:px-6 lg:px-8">
      <div class="fbi-split-section">
        <div class="max-w-xl">
          <p class="fbi-kicker text-faithGold">Research OS</p>
          <h2 class="fbi-section-title mt-3">Research software, not a mode inside finance</h2>
          <p class="mt-5 text-lg leading-relaxed text-slate-600">Eden is its own product: a local-first system for aggregating, analyzing, prioritizing, and evaluating sources. It is not a feature tucked inside CFO or Ledger.</p>
          <p class="mt-4 text-lg leading-relaxed text-slate-600">Material is organized into claims, facts, and context. Summaries remain tied to sources, with structured outputs you can audit.</p>
        </div>
        <%- include('../partials/tw-ui-mockup', { mockupType: 'eden' }) %>
      </div>
    </div>
  </section>

  <section class="border-y border-slate-200 bg-white py-20">
    <div class="mx-auto max-w-7xl px-4 sm:px-6 lg:px-8">
      <div class="mx-auto max-w-3xl text-center">
        <p class="fbi-kicker text-slate-500">Ingestion</p>
        <h2 class="mt-3 text-3xl font-bold text-navy">What Eden ingests</h2>
      </div>
      <ul class="mx-auto mt-12 grid max-w-4xl gap-4 sm:grid-cols-2">
        <li class="fbi-card fbi-card--flat flex gap-3 rounded-2xl px-4 py-3.5 text-sm text-slate-700"><span class="mt-1.5 h-1.5 w-1.5 shrink-0 rounded-full bg-faithGold"></span>Screen recordings</li>
        <li class="fbi-card fbi-card--flat flex gap-3 rounded-2xl px-4 py-3.5 text-sm text-slate-700"><span class="mt-1.5 h-1.5 w-1.5 shrink-0 rounded-full bg-faithGold"></span>Video: local files or public platforms such as YouTube, Rumble, Vimeo, or Instagram</li>
        <li class="fbi-card fbi-card--flat flex gap-3 rounded-2xl px-4 py-3.5 text-sm text-slate-700"><span class="mt-1.5 h-1.5 w-1.5 shrink-0 rounded-full bg-faithGold"></span>Articles, documents, images, and screenshots</li>
        <li class="fbi-card fbi-card--flat flex gap-3 rounded-2xl px-4 py-3.5 text-sm text-slate-700"><span class="mt-1.5 h-1.5 w-1.5 shrink-0 rounded-full bg-faithGold"></span>Your own files alongside sources you choose</li>
      </ul>
      <p class="mx-auto mt-10 max-w-2xl text-center text-sm text-slate-500">Eden transcribes audio, runs OCR where needed, and produces structured research with citations.</p>
    </div>
  </section>

  <section class="mx-auto max-w-7xl px-4 py-20 sm:px-6 lg:px-8">
    <div class="fbi-split-section">
      <div>
        <h2 class="text-2xl font-bold text-navy sm:text-3xl"><%= SITE.steward.name %> prioritizes what matters to you</h2>
        <p class="mt-4 text-slate-600 leading-relaxed">Steward is logic-driven, not open-ended generation. In Eden it helps prioritize facts using <em>your</em> context, so the same material can be ordered differently for different questions.</p>
        <p class="mt-4 text-slate-600 leading-relaxed">Sources are weighed for consistency, evidence, cross-source agreement, and relevance. Eden clarifies the landscape; it does not replace your judgment.</p>
      </div>
      <div class="fbi-card rounded-2xl p-8">
        <h3 class="text-lg font-bold text-navy">What Eden is not</h3>
        <ul class="mt-6 space-y-3 text-sm text-slate-600">
          <li class="flex gap-3"><span class="mt-1.5 h-1.5 w-1.5 shrink-0 rounded-full bg-faithGold"></span>It does not write papers or replace authorship.</li>
          <li class="flex gap-3"><span class="mt-1.5 h-1.5 w-1.5 shrink-0 rounded-full bg-faithGold"></span>It does not pass judgment on people.</li>
          <li class="flex gap-3"><span class="mt-1.5 h-1.5 w-1.5 shrink-0 rounded-full bg-faithGold"></span>It does not bypass paywalls or harvest restricted content.</li>
        </ul>
      </div>
    </div>
  </section>

  <section class="fbi-feature-band fbi-feature-band--navy py-16">
    <div class="mx-auto max-w-3xl px-4 text-center sm:px-6 lg:px-8">
      <h2 class="text-2xl font-bold text-white sm:text-3xl">Related products, separate missions</h2>
      <p class="mt-4 text-slate-200 leading-relaxed"><strong class="text-white">Sentinel</strong> is evidence intelligence. <strong class="text-white">CFO</strong> is the financial operating system. <strong class="text-white">Ledger</strong> is the identity vault and document layer. Eden turns diverse sources into prioritized, citable research on your machine.</p>
      <div class="mt-8 flex flex-wrap justify-center gap-3">
        <a href="product-sentinel.html" class="rounded-lg border border-white/25 px-4 py-2 text-sm font-semibold hover:bg-white/10">Sentinel</a>
        <a href="product-cfo.html" class="rounded-lg border border-white/25 px-4 py-2 text-sm font-semibold hover:bg-white/10">CFO</a>
        <a href="product-ledger.html" class="rounded-lg border border-white/25 px-4 py-2 text-sm font-semibold hover:bg-white/10">Ledger</a>
        <a href="compare.html" class="rounded-lg bg-faithGold px-4 py-2 text-sm font-semibold text-navy hover:bg-amber-500">Compare all</a>
      </div>
    </div>
  </section>

  <%- include('../partials/tw-availability') %>
</main>
<%- include('../partials/tw-footer') %>
<%- include('../partials/tw-scripts') %>
</body>
</html>
