<%- include('../partials/tw-head') -%>
<body class="fbi-site flex min-h-full flex-col bg-slate-50 text-slate-800 antialiased">
<%- include('../partials/tw-header') -%>
<main class="flex-1">
  <%- include('../partials/tw-hero-premium', {
    heroEyebrow: 'Compare',
    heroTitle: 'Four distinct products.',
    heroLead: 'Understand scope and boundaries. None of these titles are offered for sale or download today. The comparison exists so the architecture reads clearly.',
    heroSplit: true,
    heroMockup: 'suite',
    heroCompact: true
  }) -%>

  <section class="mx-auto max-w-7xl px-4 py-12 sm:px-6 lg:px-8">
    <div class="fbi-table-wrap overflow-x-auto">
      <table class="min-w-[960px] w-full border-collapse text-left text-sm">
        <thead>
          <tr class="border-b border-slate-200 bg-gradient-to-r from-slate-50 to-white">
            <th scope="col" class="px-4 py-5 font-semibold text-navy sm:px-6"></th>
            <th scope="col" class="px-4 py-5 text-center font-semibold text-navy sm:px-6">
              <span class="inline-block rounded-xl border border-slate-200 bg-white px-3 py-2 text-sm shadow-fbi-sm">Sentinel</span>
            </th>
            <th scope="col" class="px-4 py-5 text-center font-semibold sm:px-6">
              <span class="inline-block rounded-xl border-2 border-faithGold/40 bg-amber-50/80 px-3 py-2 text-sm text-navy shadow-fbi-sm fbi-glow-gold">CFO</span>
            </th>
            <th scope="col" class="px-4 py-5 text-center font-semibold text-navy sm:px-6">
              <span class="inline-block rounded-xl border border-slate-200 bg-white px-3 py-2 text-sm shadow-fbi-sm">Eden</span>
            </th>
            <th scope="col" class="px-4 py-5 text-center font-semibold text-navy sm:px-6">
              <span class="inline-block rounded-xl border border-slate-200 bg-white px-3 py-2 text-sm shadow-fbi-sm">Ledger</span>
            </th>
          </tr>
        </thead>
        <tbody class="divide-y divide-slate-100 text-slate-600">
          <tr>
            <th scope="row" class="whitespace-nowrap bg-slate-50/80 px-4 py-4 font-semibold text-navy sm:px-6">Core job</th>
            <td class="px-4 py-4 align-top sm:px-6">Evidence intelligence: ingest, organize, timeline, relationship mapping, structured exports for review workflows.</td>
            <td class="bg-amber-50/30 px-4 py-4 align-top sm:px-6">Financial operating system: budgeting, planning, forecasting, cash flow, structured money intelligence.</td>
            <td class="px-4 py-4 align-top sm:px-6">Research aggregation, analysis, prioritization, and source evaluation with citations.</td>
            <td class="px-4 py-4 align-top sm:px-6">Encrypted identity vault and deterministic document prefilling.</td>
          </tr>
          <tr>
            <th scope="row" class="whitespace-nowrap bg-slate-50/80 px-4 py-4 font-semibold text-navy sm:px-6">Typical inputs</th>
            <td class="px-4 py-4 align-top sm:px-6">PDFs, images, spreadsheets, message logs, documents, media references: evidence collections.</td>
            <td class="bg-amber-50/20 px-4 py-4 align-top sm:px-6">Accounts, plans, OCR documents, optional Plaid: financial data only.</td>
            <td class="px-4 py-4 align-top sm:px-6">Recordings, video, articles, images, screenshots, public or user-provided material.</td>
            <td class="px-4 py-4 align-top sm:px-6">Identity fields, history, relationships, documents: up to two people (e.g. spouses).</td>
          </tr>
          <tr>
            <th scope="row" class="whitespace-nowrap bg-slate-50/80 px-4 py-4 font-semibold text-navy sm:px-6"><%= SITE.steward.name %></th>
            <td class="px-4 py-4 align-top sm:px-6">Evidence organization assistant: timelines, patterns, summaries, and review prep from your material. No legal conclusions.</td>
            <td class="bg-amber-50/20 px-4 py-4 align-top sm:px-6">Interprets finances; surfaces patterns, risks, projections, and runway from recorded data.</td>
            <td class="px-4 py-4 align-top sm:px-6">Prioritizes facts to your context; scores sources on consistency, evidence, agreement, relevance.</td>
            <td class="px-4 py-4 align-top sm:px-6">Helps parse documents and map fields; never generates or guesses field values.</td>
          </tr>
          <tr>
            <th scope="row" class="whitespace-nowrap bg-slate-50/80 px-4 py-4 font-semibold text-navy sm:px-6">Explicitly not</th>
            <td class="px-4 py-4 align-top sm:px-6">Legal advice, attorney replacement, predictive legal engine, or cloud surveillance.</td>
            <td class="bg-amber-50/20 px-4 py-4 align-top sm:px-6">A research tool, life tracker, or open-ended chat for money.</td>
            <td class="px-4 py-4 align-top sm:px-6">A CFO mode, ghostwriter, paywall bypass, or judge of people.</td>
            <td class="px-4 py-4 align-top sm:px-6">A finance app, research notebook, or autofill that infers missing answers.</td>
          </tr>
          <tr class="bg-amber-50/50">
            <th scope="row" class="whitespace-nowrap px-4 py-4 font-semibold text-navy sm:px-6">Build status</th>
            <td class="px-4 py-4 sm:px-6 font-medium text-slate-700"><%= PRODUCTS.sentinel.development.stage %> (as of <%= PRODUCTS.sentinel.development.asOf %>). Not for sale or download.</td>
            <td class="px-4 py-4 sm:px-6 font-medium text-slate-700" colspan="3"><%= SITE.availability.line %></td>
          </tr>
        </tbody>
      </table>
    </div>

    <section class="mt-16 fbi-glass rounded-3xl p-8 sm:p-10 fbi-glow-gold" aria-labelledby="compare-fintech-heading">
      <h2 id="compare-fintech-heading" class="fbi-section-title text-2xl sm:text-3xl">CFO and the fintech default</h2>
      <p class="mt-4 text-base leading-relaxed text-slate-600">Many apps bundle bank feeds, credit scores, and cross-sell into one noisy surface, optimized for time-in-app, not clarity. <strong class="font-semibold text-navy">CFO</strong> is intentionally different: a local-first financial operating system with deterministic <%= SITE.steward.name %> logic and structured inputs.</p>
      <p class="mt-4 text-base leading-relaxed text-slate-600"><strong class="font-semibold text-navy">Sentinel</strong>, <strong class="font-semibold text-navy">Eden</strong>, and <strong class="font-semibold text-navy">Ledger</strong> answer different questions. None of our titles blur those missions for engagement metrics.</p>
    </section>

    <div class="mt-12 flex flex-wrap gap-3">
      <a href="product-sentinel.html" class="inline-flex rounded-lg border border-slate-300 bg-white px-4 py-2 text-sm font-semibold text-navy shadow-sm transition duration-280 ease-fbi-out hover:border-slate-500 hover:shadow-fbi-sm">Sentinel</a>
      <a href="product-cfo.html" class="inline-flex rounded-lg border border-slate-300 bg-white px-4 py-2 text-sm font-semibold text-navy shadow-sm transition duration-280 ease-fbi-out hover:border-faithGold hover:text-faithGold hover:shadow-fbi-sm">CFO</a>
      <a href="product-eden.html" class="inline-flex rounded-lg border border-slate-300 bg-white px-4 py-2 text-sm font-semibold text-navy shadow-sm transition duration-280 ease-fbi-out hover:border-faithGold hover:text-faithGold hover:shadow-fbi-sm">Eden</a>
      <a href="product-ledger.html" class="inline-flex rounded-lg border border-slate-300 bg-white px-4 py-2 text-sm font-semibold text-navy shadow-sm transition duration-280 ease-fbi-out hover:border-faithGold hover:text-faithGold hover:shadow-fbi-sm">Ledger</a>
      <span class="inline-flex items-center rounded-lg border border-amber-200 bg-amber-50 px-4 py-2 text-sm font-semibold text-amber-900" role="status"><%= SITE.availability.badge %></span>
    </div>
  </section>
</main>
<%- include('../partials/tw-footer') %>
<%- include('../partials/tw-scripts') %>
</body>
</html>
