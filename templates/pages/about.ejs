<%- include('../partials/tw-head') -%>
<body class="fbi-site flex min-h-full flex-col bg-slate-50 text-slate-800 antialiased">
<%- include('../partials/tw-header') -%>
<main class="flex-1">
  <%- include('../partials/tw-hero-premium', {
    heroEyebrow: 'About ' + SITE.brand,
    heroTitle: 'We build with stewardship, discipline, and deep respect for serious work.',
    heroLead: SITE.brand + ' is a faith-based software company creating premium desktop products with clear boundaries and clear accountability. We build with intent, clarity, and respect for your data and your time.',
    heroCompact: true
  }) -%>

  <section class="mx-auto max-w-7xl px-4 py-20 sm:px-6 sm:py-24 lg:px-8">
    <div class="fbi-stagger-grid grid gap-8 lg:grid-cols-3">
      <article class="fbi-card p-8">
        <h2 class="text-xl font-bold text-navy">Faith-based stewardship</h2>
        <p class="mt-3 text-slate-600 leading-relaxed"><%= SITE.brand %> is rooted in stewardship and disciplined work. We believe software should serve people with honesty, structure, and responsibility rather than manipulation or hype.</p>
      </article>
      <article class="fbi-card p-8 lg:translate-y-3">
        <h2 class="text-xl font-bold text-navy">Standalone product missions</h2>
        <p class="mt-3 text-slate-600 leading-relaxed"><strong class="text-navy">Sentinel</strong>, <strong class="text-navy">CFO</strong>, <strong class="text-navy">Eden</strong>, and <strong class="text-navy">Ledger</strong> are each standalone products with distinct jobs. We do not collapse evidence, finance, research, and identity into one confusing app.</p>
      </article>
      <article class="fbi-card p-8">
        <h2 class="text-xl font-bold text-navy">Controlled intelligence</h2>
        <p class="mt-3 text-slate-600 leading-relaxed"><%= SITE.steward.name %> is our controlled, rules-based intelligence layer. It is deterministic, auditable, and trustworthy by design, not open-ended generation and not magic.</p>
      </article>
    </div>
  </section>

  <section class="fbi-feature-band fbi-grid-bg border-y border-slate-200">
    <div class="mx-auto grid max-w-7xl gap-14 px-4 py-20 sm:px-6 lg:grid-cols-2 lg:items-center lg:px-8">
      <article>
        <p class="fbi-kicker text-faithGold">Conviction</p>
        <h2 class="mt-3 text-3xl font-bold tracking-tight text-navy sm:text-4xl">Local-first and privacy-first by conviction</h2>
        <p class="mt-5 text-lg leading-relaxed text-slate-600">Serious work belongs on serious machines. <%= SITE.brand %> rejects cloud dependency and surveillance-style growth models that treat users like telemetry feeds.</p>
        <p class="mt-4 text-lg leading-relaxed text-slate-600">Our products are engineered for local-first workflows and privacy-first operation, so control stays with the person doing the work.</p>
      </article>
      <div class="fbi-card rounded-2xl border border-slate-200/90 bg-white p-8 shadow-inner">
        <h3 class="text-sm font-bold uppercase tracking-[0.14em] text-slate-500">How we build</h3>
        <ul class="mt-5 space-y-3 text-sm leading-relaxed text-slate-600">
          <li class="flex gap-3"><span class="mt-1.5 h-1.5 w-1.5 shrink-0 rounded-full bg-faithGold"></span>Deliberate architecture over rushed feature churn</li>
          <li class="flex gap-3"><span class="mt-1.5 h-1.5 w-1.5 shrink-0 rounded-full bg-faithGold"></span>Deterministic guidance over probabilistic guesswork</li>
          <li class="flex gap-3"><span class="mt-1.5 h-1.5 w-1.5 shrink-0 rounded-full bg-faithGold"></span>Clear product boundaries over ambiguous all-in-one UX</li>
          <li class="flex gap-3"><span class="mt-1.5 h-1.5 w-1.5 shrink-0 rounded-full bg-faithGold"></span>Respect for user data, attention, and long-term trust</li>
        </ul>
      </div>
    </div>
  </section>

  <section class="mx-auto max-w-4xl px-4 py-20 text-center sm:px-6 lg:px-8">
    <blockquote class="fbi-statement mx-auto max-w-2xl text-left sm:text-center">
      <%= SITE.brand %> does not ship noise. We build premium desktop software with clear missions, transparent behavior, and principled engineering so serious users can do serious work with confidence.
    </blockquote>
    <h2 class="sr-only">Built with intent and accountability</h2>
  </section>
</main>
<%- include('../partials/tw-footer') %>
<%- include('../partials/tw-scripts') %>
</body>
</html>
