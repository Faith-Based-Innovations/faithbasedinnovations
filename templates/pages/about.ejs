<%- include('../partials/tw-head') -%>
<body class="fbi-site flex min-h-full flex-col bg-slate-50 text-slate-800 antialiased">
<%- include('../partials/tw-header') -%>
<main class="flex-1">
  <%- include('../partials/tw-hero-premium', {
    heroEyebrow: 'About ' + SITE.brand,
    heroTitle: 'Software built with stewardship and discipline.',
    heroLead: SITE.brand + ' creates premium desktop products with clear boundaries and clear accountability. We build with intent, clarity, and respect for your data and your time.',
    heroSplit: true,
    heroMockup: 'steward',
    heroActionsHtml: '<a href="products.html" class="inline-flex min-h-[3rem] items-center justify-center rounded-full bg-faithGold px-7 text-sm font-semibold text-white hover:bg-amber-600 focus:outline-none focus-visible:ring-2 focus-visible:ring-amber-300 focus-visible:ring-offset-2 focus-visible:ring-offset-navy">Our products</a>'
  }) -%>

  <section class="mx-auto max-w-7xl px-4 py-20 sm:px-6 sm:py-28 lg:px-8">
    <div class="fbi-stagger-grid grid gap-8 lg:grid-cols-3">
      <article class="fbi-card fbi-card--glow p-8">
        <h2 class="text-xl font-bold text-navy">Faith-based stewardship</h2>
        <p class="mt-3 text-slate-600 leading-relaxed"><%= SITE.brand %> is rooted in stewardship and disciplined work. Software should serve people with honesty and structure, not manipulation or hype.</p>
      </article>
      <article class="fbi-card fbi-card--glow p-8 lg:translate-y-4">
        <h2 class="text-xl font-bold text-navy">Separate focused applications</h2>
        <p class="mt-3 text-slate-600 leading-relaxed"><strong class="text-navy">Sentinel</strong>, <strong class="text-navy">CFO</strong>, <strong class="text-navy">Eden</strong>, and <strong class="text-navy">Ledger</strong> each have a distinct job. We build modular software, not one confusing monolith.</p>
      </article>
      <article class="fbi-card fbi-card--glow p-8">
        <h2 class="text-xl font-bold text-navy"><%= SITE.steward.name %> as differentiator</h2>
        <p class="mt-3 text-slate-600 leading-relaxed"><%= SITE.steward.name %> is our shared local operational guidance layer: deterministic, permission-aware, and trustworthy by design. It works inside each product without becoming an AI overlord or generic chatbot.</p>
      </article>
    </div>
  </section>

  <section class="fbi-feature-band fbi-grid-bg border-y border-slate-200">
    <div class="mx-auto grid max-w-7xl gap-14 px-4 py-20 sm:px-6 lg:grid-cols-2 lg:items-center lg:px-8 sm:py-28">
      <article>
        <p class="fbi-kicker text-faithGold">Conviction</p>
        <h2 class="fbi-section-title mt-3">Local-first and privacy-first</h2>
        <p class="fbi-section-lead">Serious work belongs on serious machines. Our products are engineered for local workflows so control stays with the person doing the work.</p>
      </article>
      <div class="fbi-glass rounded-2xl p-8">
        <h3 class="text-sm font-bold uppercase tracking-[0.14em] text-slate-500">How we build</h3>
        <ul class="mt-5 space-y-3 text-sm leading-relaxed text-slate-600">
          <li class="flex gap-3"><span class="mt-1.5 h-1.5 w-1.5 shrink-0 rounded-full bg-faithGold"></span>Deliberate architecture over rushed feature churn</li>
          <li class="flex gap-3"><span class="mt-1.5 h-1.5 w-1.5 shrink-0 rounded-full bg-faithGold"></span>Deterministic guidance over probabilistic guesswork</li>
          <li class="flex gap-3"><span class="mt-1.5 h-1.5 w-1.5 shrink-0 rounded-full bg-faithGold"></span>Clear product boundaries over merged super-app UX</li>
          <li class="flex gap-3"><span class="mt-1.5 h-1.5 w-1.5 shrink-0 rounded-full bg-faithGold"></span>Respect for user data, attention, and long-term trust</li>
        </ul>
      </div>
    </div>
  </section>

  <section class="fbi-ambient fbi-ambient--gold">
    <div class="fbi-ambient__inner mx-auto max-w-4xl px-4 py-20 text-center sm:px-6 lg:px-8">
      <blockquote class="fbi-statement mx-auto max-w-2xl text-left sm:text-center">
        <%= SITE.brand %> builds premium desktop software with clear missions, transparent behavior, and principled engineering so serious users can work with confidence.
      </blockquote>
    </div>
  </section>
</main>
<%- include('../partials/tw-footer') %>
<%- include('../partials/tw-scripts') %>
</body>
</html>
