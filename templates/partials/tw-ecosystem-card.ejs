<%
  var ecoId = typeof productId !== "undefined" ? productId : "";
  var p = NAV_PRODUCTS.find(function (x) { return x.id === ecoId; });
  var prod = p ? PRODUCTS[p.id] : null;
  var bentoClass = "fbi-bento__" + ecoId;
%>
<% if (p && prod) {
  var tagClass = p.id === "sentinel" ? "text-slate-600" : "text-faithGold";
%>
<article class="fbi-eco-card fbi-card fbi-card--glow fbi-glass <%= bentoClass %>">
  <div class="fbi-eco-card__visual">
    <%- include('./tw-ui-mockup', { mockupType: p.id, mockupDark: p.id === 'sentinel', mockupCompact: true }) %>
  </div>
  <div class="fbi-eco-card__body">
    <div class="flex flex-wrap items-center justify-between gap-2">
      <span class="text-[10px] font-bold uppercase tracking-wider <%= tagClass %>"><%= prod.tag %></span>
      <span class="rounded-full bg-slate-100 px-2 py-0.5 text-[10px] font-semibold text-slate-600 ring-1 ring-slate-200"><%= prod.statusBadge || SITE.availability.badge %></span>
    </div>
    <h3 class="mt-3 text-xl font-bold text-navy sm:text-2xl"><%= p.label %></h3>
    <p class="mt-2 text-sm leading-relaxed text-slate-600"><%= prod.cardBlurb %></p>
    <a href="<%= p.href %>" class="mt-5 inline-flex text-sm font-semibold text-navy underline-offset-4 hover:text-faithGold hover:underline focus:outline-none focus-visible:ring-2 focus-visible:ring-faithGold rounded-sm">Explore <%= p.label %> →</a>
  </div>
</article>
<% } %>
