<%
  var sentinelDev = PRODUCTS.sentinel.development || {};
  var sentinelTimeline = Array.isArray(sentinelDev.timeline) ? sentinelDev.timeline : [];
  var sentinelAsOfIso = sentinelDev.asOfIso || "";
%>
<section class="border-y border-slate-300/60 bg-gradient-to-b from-slate-100/90 to-slate-50/80" aria-label="Sentinel development status">
  <div class="mx-auto max-w-3xl px-4 py-16 text-center sm:px-6 lg:px-8">
    <p class="text-xs font-bold uppercase tracking-[0.2em] text-faithGold">
      <%= sentinelDev.stage %> <span aria-hidden="true">·</span> as of <time datetime="<%= sentinelAsOfIso %>"><%= sentinelDev.asOf %></time>
    </p>
    <p class="mt-4 text-base leading-relaxed text-slate-700"><%= sentinelDev.summary %></p>
    <% if (sentinelTimeline.length) { %>
    <ol class="fbi-timeline mt-8" aria-label="Sentinel build milestones">
      <% sentinelTimeline.forEach(function (item, idx) {
        var isCurrent = idx === sentinelTimeline.length - 1;
      %>
      <li class="fbi-timeline__item <%= isCurrent ? 'fbi-timeline__item--current' : 'fbi-timeline__item--past' %>">
        <span class="fbi-timeline__dot" aria-hidden="true"></span>
        <span class="fbi-timeline__date"><time datetime="<%= item.iso %>"><%= item.date %></time></span>
        <span class="fbi-timeline__label"><%= item.label %></span>
      </li>
      <% }); %>
    </ol>
    <p class="sr-only">Build velocity: from advanced internal alpha to beta testing in six days.</p>
    <% } %>
    <p class="mt-6 text-sm text-slate-600">Sentinel is not offered for sale or download. Major systems remain under active integration and refinement.</p>
    <p class="mt-3 text-sm font-medium text-navy" role="status">Actively under development: operational evidence intelligence, validated against real workflows.</p>
  </div>
</section>
