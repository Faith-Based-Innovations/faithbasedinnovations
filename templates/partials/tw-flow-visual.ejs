<%
  var fTitle = typeof flowTitle !== "undefined" ? flowTitle : "How your data moves";
  var fLead = typeof flowLead !== "undefined" ? flowLead : "";
  var fVariant = typeof flowVariant !== "undefined" ? flowVariant : "light";
%>
<div class="fbi-flow-visual fbi-flow-visual--<%= fVariant %> fbi-grid-bg" role="img" aria-label="Data flow: your device, encrypted local vault, <%= SITE.steward.name %> rules, optional sync you control">
  <% if (fTitle) { %>
  <h3 class="fbi-flow-visual__title"><%= fTitle %></h3>
  <% } %>
  <% if (fLead) { %>
  <p class="fbi-flow-visual__lead"><%= fLead %></p>
  <% } %>
  <div class="fbi-flow-visual__track">
    <div class="fbi-flow-visual__step">
      <img src="./assets/illustrations/flow-device.png" alt="" width="88" height="88" loading="lazy" decoding="async" class="fbi-flow-visual__icon fbi-flow-visual__icon--device" />
      <p class="fbi-flow-visual__label">Your device</p>
      <p class="fbi-flow-visual__hint">Native storage</p>
    </div>
    <span class="fbi-flow-visual__connector" aria-hidden="true"><span class="fbi-flow-visual__connector-line"></span></span>
    <div class="fbi-flow-visual__step fbi-flow-visual__step--accent">
      <img src="./assets/illustrations/flow-vault.png" alt="" width="88" height="88" loading="lazy" decoding="async" class="fbi-flow-visual__icon fbi-flow-visual__icon--vault" />
      <p class="fbi-flow-visual__label">Local vault</p>
      <p class="fbi-flow-visual__hint">Encrypted where it matters</p>
    </div>
    <span class="fbi-flow-visual__connector" aria-hidden="true"><span class="fbi-flow-visual__connector-line"></span></span>
    <div class="fbi-flow-visual__step fbi-flow-visual__step--accent">
      <img src="./assets/illustrations/flow-steward.png" alt="" width="88" height="88" loading="lazy" decoding="async" class="fbi-flow-visual__icon fbi-flow-visual__icon--steward" />
      <p class="fbi-flow-visual__label"><%= SITE.steward.name %></p>
      <p class="fbi-flow-visual__hint">User-trainable layer</p>
    </div>
    <span class="fbi-flow-visual__connector fbi-flow-visual__connector--dashed" aria-hidden="true"><span class="fbi-flow-visual__connector-line"></span></span>
    <div class="fbi-flow-visual__step">
      <img src="./assets/illustrations/flow-sync.png" alt="" width="88" height="88" loading="lazy" decoding="async" class="fbi-flow-visual__icon fbi-flow-visual__icon--sync" />
      <p class="fbi-flow-visual__label">Optional sync</p>
      <p class="fbi-flow-visual__hint">You choose</p>
    </div>
  </div>
  <div class="fbi-flow-visual__trust" aria-hidden="true">
    <span class="fbi-flow-visual__trust-item"><span class="fbi-flow-visual__trust-dot"></span>No telemetry feeds</span>
    <span class="fbi-flow-visual__trust-item"><span class="fbi-flow-visual__trust-dot fbi-flow-visual__trust-dot--gold"></span>Traceable inputs</span>
    <span class="fbi-flow-visual__trust-item"><span class="fbi-flow-visual__trust-dot"></span>Explicit boundaries</span>
  </div>
</div>
