<script>
  (function () {
    var btn = document.getElementById("tw-menu-btn");
    var panel = document.getElementById("tw-menu-panel");
    if (!btn || !panel) return;
    btn.addEventListener("click", function () {
      var open = btn.getAttribute("aria-expanded") === "true";
      btn.setAttribute("aria-expanded", open ? "false" : "true");
      panel.classList.toggle("hidden", open);
    });
  })();
</script>
<script>
  (function () {
    if (window.matchMedia("(prefers-reduced-motion: reduce)").matches) {
      document.documentElement.classList.add("fbi-reduced-motion");
      return;
    }
    var main = document.querySelector("main");
    if (!main) return;
    var all = Array.prototype.slice.call(main.querySelectorAll(":scope > section"));
    if (!all.length) all = Array.prototype.slice.call(main.children);
    var nodes = all.length > 1 ? all.slice(1) : [];
    var yAttr = ["sm", "md", "lg"];
    nodes.forEach(function (el, i) {
      el.classList.add("fbi-reveal");
      el.setAttribute("data-fbi-y", yAttr[i % 3]);
    });
    var io = new IntersectionObserver(
      function (entries) {
        entries.forEach(function (ent) {
          if (!ent.isIntersecting) return;
          var t = ent.target;
          requestAnimationFrame(function () {
            t.classList.add("fbi-reveal--visible");
          });
          io.unobserve(t);
        });
      },
      { rootMargin: "0px 0px -48px 0px", threshold: 0.04 }
    );
    nodes.forEach(function (el) {
      io.observe(el);
    });
  })();
</script>
<script>
  (function () {
    if (window.matchMedia("(prefers-reduced-motion: reduce)").matches) return;
    var wrap = document.querySelector(".fbi-steward-flow__requests");
    if (!wrap) return;
    var items = wrap.querySelectorAll(".fbi-steward-flow__request");
    if (items.length < 2) return;
    var idx = 0;
    window.setInterval(function () {
      items[idx].classList.remove("fbi-steward-flow__request--active");
      idx = (idx + 1) % items.length;
      items[idx].classList.add("fbi-steward-flow__request--active");
    }, 4200);
  })();
</script>
<script>
  (function () {
    var flow = document.querySelector(".fbi-steward-flow");
    if (!flow) return;
    var nodes = flow.querySelectorAll(".fbi-steward-flow__node[data-steward-node]");
    var apps = flow.querySelectorAll(".fbi-steward-flow__app[data-app]");
    function clearGlow() {
      flow.classList.remove("fbi-steward-flow--glow-rules", "fbi-steward-flow--glow-memory", "fbi-steward-flow--glow-permissions", "fbi-steward-flow--glow-vault", "fbi-steward-flow--glow-context", "fbi-steward-flow--glow-tools");
      apps.forEach(function (a) {
        a.classList.remove("fbi-steward-flow__app--lit");
      });
    }
    nodes.forEach(function (btn) {
      btn.addEventListener("mouseenter", function () {
        clearGlow();
        var id = btn.getAttribute("data-steward-node");
        if (id) flow.classList.add("fbi-steward-flow--glow-" + id);
      });
      btn.addEventListener("focus", function () {
        btn.dispatchEvent(new Event("mouseenter"));
      });
      btn.addEventListener("mouseleave", clearGlow);
      btn.addEventListener("blur", clearGlow);
    });
    apps.forEach(function (app) {
      app.addEventListener("mouseenter", function () {
        clearGlow();
        app.classList.add("fbi-steward-flow__app--lit");
      });
      app.addEventListener("mouseleave", clearGlow);
    });
  })();
</script>
<script>
  (function () {
    var root = document.querySelector("[data-steward-app-demo]");
    if (!root) return;

    var APPS = ["cfo", "sentinel", "eden", "ledger"];
    var STEP_MS = [1100, 1400, 1800, 1200, 1500];
    var TRANSITION_MS = 520;
    var PERM_BY_APP = {
      cfo: "Create follow-up reminder?",
      sentinel: "Export review packet?",
      eden: "Confirm topic clusters?",
      ledger: "Allow autofill from vault?"
    };
    var TITLE_BY_APP = {
      cfo: "Faith Based Innovations — CFO",
      sentinel: "Faith Based Innovations — Sentinel",
      eden: "Faith Based Innovations — Eden",
      ledger: "Faith Based Innovations — Ledger"
    };
    var CRUMB_BY_APP = {
      cfo: "Transactions",
      sentinel: "Evidence workspace",
      eden: "Research library",
      ledger: "Form fill"
    };
    var LEDGER_VALUES = {
      name: "Jordan A. Lee",
      address: "1842 Cedar Lane",
      city: "Austin, TX 78701",
      ssn: ""
    };

    var tabs = root.querySelectorAll("[data-app-tab]");
    var navItems = root.querySelectorAll("[data-app-nav]");
    var dots = root.querySelectorAll("[data-app-dot]");
    var scenes = root.querySelectorAll("[data-scene]");
    var prompts = root.querySelectorAll("[data-app-prompt]");
    var analyses = root.querySelectorAll("[data-app-analysis]");
    var outcomes = root.querySelectorAll("[data-app-outcome]");
    var permBox = root.querySelector("[data-app-permission]");
    var permText = root.querySelector("[data-app-permission-text]");
    var toasts = root.querySelectorAll("[data-app-toast]");
    var windowTitle = root.querySelector("[data-app-window-title]");
    var crumbActive = root.querySelector("[data-app-crumb-active]");
    var crumbView = root.querySelector("[data-app-crumb-view]");
    var toggleBtn = root.querySelector("[data-app-toggle]");
    var toggleLabel = root.querySelector("[data-app-toggle-label]");
    var ledgerInputs = root.querySelectorAll(".fbi-scene-ledger__field input");

    var appIdx = 0;
    var stepIdx = 0;
    var timer = null;
    var reduced = window.matchMedia("(prefers-reduced-motion: reduce)").matches;
    var paused = root.getAttribute("data-paused") === "true";

    function clearTimer() {
      if (timer) window.clearTimeout(timer);
      timer = null;
    }

    function setLedgerFields(step) {
      ledgerInputs.forEach(function (input) {
        var key = input.getAttribute("data-field");
        if (!key || key === "ssn") return;
        if (step >= 2) {
          input.value = LEDGER_VALUES[key] || "";
        } else {
          input.value = "";
        }
      });
    }

    function setApp(id) {
      root.setAttribute("data-app", id);
      root.classList.add("fbi-app-demo--transition");
      window.setTimeout(function () {
        root.classList.remove("fbi-app-demo--transition");
      }, TRANSITION_MS);

      tabs.forEach(function (tab) {
        var on = tab.getAttribute("data-app-tab") === id;
        tab.classList.toggle("fbi-app-demo__tab--active", on);
        tab.setAttribute("aria-selected", on ? "true" : "false");
      });
      navItems.forEach(function (btn) {
        btn.classList.toggle("fbi-app-window__nav-item--active", btn.getAttribute("data-app-nav") === id);
      });
      dots.forEach(function (dot) {
        dot.classList.toggle("fbi-app-demo__dot--active", dot.getAttribute("data-app-dot") === id);
      });
      scenes.forEach(function (scene) {
        scene.classList.toggle("fbi-app-scene--active", scene.getAttribute("data-scene") === id);
      });
      prompts.forEach(function (p) {
        p.classList.toggle("fbi-app-window__steward-prompt--active", p.getAttribute("data-app-prompt") === id);
      });
      analyses.forEach(function (a) {
        a.classList.toggle("fbi-app-window__steward-lines--active", a.getAttribute("data-app-analysis") === id);
      });
      outcomes.forEach(function (o) {
        o.classList.toggle("fbi-app-window__steward-result--active", o.getAttribute("data-app-outcome") === id);
      });

      if (windowTitle) windowTitle.textContent = TITLE_BY_APP[id] || TITLE_BY_APP.cfo;
      if (crumbActive) crumbActive.textContent = id.charAt(0).toUpperCase() + id.slice(1);
      if (crumbView) crumbView.textContent = CRUMB_BY_APP[id] || "";
      if (permText) permText.textContent = PERM_BY_APP[id] || "Approve action?";
      setLedgerFields(0);
    }

    function setStep(step) {
      stepIdx = step;
      root.setAttribute("data-scene-step", String(step));

      if (permBox) permBox.hidden = step !== 3;
      toasts.forEach(function (t, i) {
        t.classList.toggle("fbi-app-window__toast--visible", step === 4 && i === (appIdx % 3));
      });

      if (root.getAttribute("data-app") === "ledger") {
        setLedgerFields(step);
      }
    }

    function scheduleNext() {
      clearTimer();
      if (paused || reduced) return;
      timer = window.setTimeout(advance, STEP_MS[stepIdx] || 1200);
    }

    function advance() {
      if (stepIdx >= 4) {
        stepIdx = 0;
        appIdx = (appIdx + 1) % APPS.length;
        setApp(APPS[appIdx]);
      } else {
        stepIdx += 1;
      }
      setStep(stepIdx);
      scheduleNext();
    }

    function resetDemo(appId, finalStep) {
      clearTimer();
      appIdx = APPS.indexOf(appId);
      if (appIdx < 0) appIdx = 0;
      setApp(APPS[appIdx]);
      setStep(finalStep != null ? finalStep : 0);
      if (!paused && !reduced) scheduleNext();
    }

    function showReducedFinal() {
      clearTimer();
      setApp(APPS[appIdx]);
      setStep(4);
      if (permBox) permBox.hidden = false;
      toasts.forEach(function (t, i) {
        t.classList.toggle("fbi-app-window__toast--visible", i === 0);
      });
      setLedgerFields(4);
    }

    tabs.forEach(function (tab) {
      tab.addEventListener("click", function () {
        var id = tab.getAttribute("data-app-tab");
        if (!id) return;
        resetDemo(id, reduced ? 4 : 0);
        if (reduced) showReducedFinal();
      });
    });

    navItems.forEach(function (btn) {
      btn.addEventListener("click", function () {
        var id = btn.getAttribute("data-app-nav");
        if (!id) return;
        resetDemo(id, reduced ? 4 : 0);
        if (reduced) showReducedFinal();
      });
    });

    if (toggleBtn) {
      toggleBtn.addEventListener("click", function () {
        paused = !paused;
        root.setAttribute("data-paused", paused ? "true" : "false");
        toggleBtn.setAttribute("aria-pressed", paused ? "true" : "false");
        toggleBtn.setAttribute("aria-label", paused ? "Play animation" : "Pause animation");
        if (toggleLabel) toggleLabel.textContent = paused ? "Play" : "Pause";
        if (paused) clearTimer();
        else if (!reduced) scheduleNext();
      });
    }

    setApp(APPS[0]);
    if (reduced) {
      showReducedFinal();
      return;
    }
    setStep(0);
    scheduleNext();
  })();
</script>