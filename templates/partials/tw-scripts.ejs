<script>
  (function () {
    var btn = document.getElementById("tw-menu-btn");
    var panel = document.getElementById("tw-menu-panel");
    if (!btn || !panel) return;
    btn.addEventListener("click", function () {
      var open = btn.getAttribute("aria-expanded") === "true";
      btn.setAttribute("aria-expanded", open ? "false" : "true");
      panel.classList.toggle("hidden", open);
    });
  })();
</script>
<script>
  (function () {
    if (window.matchMedia("(prefers-reduced-motion: reduce)").matches) {
      document.documentElement.classList.add("fbi-reduced-motion");
      return;
    }
    var main = document.querySelector("main");
    if (!main) return;
    var all = Array.prototype.slice.call(main.querySelectorAll(":scope > section"));
    if (!all.length) all = Array.prototype.slice.call(main.children);
    var nodes = all.length > 1 ? all.slice(1) : [];
    var yAttr = ["sm", "md", "lg"];
    nodes.forEach(function (el, i) {
      el.classList.add("fbi-reveal");
      el.setAttribute("data-fbi-y", yAttr[i % 3]);
    });
    var io = new IntersectionObserver(
      function (entries) {
        entries.forEach(function (ent) {
          if (!ent.isIntersecting) return;
          var t = ent.target;
          requestAnimationFrame(function () {
            t.classList.add("fbi-reveal--visible");
          });
          io.unobserve(t);
        });
      },
      { rootMargin: "0px 0px -48px 0px", threshold: 0.04 }
    );
    nodes.forEach(function (el) {
      io.observe(el);
    });
  })();
</script>
<script>
  (function () {
    if (window.matchMedia("(prefers-reduced-motion: reduce)").matches) return;
    var wrap = document.querySelector(".fbi-steward-flow__requests");
    if (!wrap) return;
    var items = wrap.querySelectorAll(".fbi-steward-flow__request");
    if (items.length < 2) return;
    var idx = 0;
    window.setInterval(function () {
      items[idx].classList.remove("fbi-steward-flow__request--active");
      idx = (idx + 1) % items.length;
      items[idx].classList.add("fbi-steward-flow__request--active");
    }, 4200);
  })();
</script>
<script>
  (function () {
    var flow = document.querySelector(".fbi-steward-flow");
    if (!flow) return;
    var nodes = flow.querySelectorAll(".fbi-steward-flow__node[data-steward-node]");
    var apps = flow.querySelectorAll(".fbi-steward-flow__app[data-app]");
    function clearGlow() {
      flow.classList.remove("fbi-steward-flow--glow-rules", "fbi-steward-flow--glow-memory", "fbi-steward-flow--glow-permissions", "fbi-steward-flow--glow-vault", "fbi-steward-flow--glow-context", "fbi-steward-flow--glow-tools");
      apps.forEach(function (a) {
        a.classList.remove("fbi-steward-flow__app--lit");
      });
    }
    nodes.forEach(function (btn) {
      btn.addEventListener("mouseenter", function () {
        clearGlow();
        var id = btn.getAttribute("data-steward-node");
        if (id) flow.classList.add("fbi-steward-flow--glow-" + id);
      });
      btn.addEventListener("focus", function () {
        btn.dispatchEvent(new Event("mouseenter"));
      });
      btn.addEventListener("mouseleave", clearGlow);
      btn.addEventListener("blur", clearGlow);
    });
    apps.forEach(function (app) {
      app.addEventListener("mouseenter", function () {
        clearGlow();
        app.classList.add("fbi-steward-flow__app--lit");
      });
      app.addEventListener("mouseleave", clearGlow);
    });
  })();
</script>
<script>
  (function () {
    var root = document.querySelector("[data-steward-movie]");
    if (!root) return;

    var STAGES = ["request", "receive", "processing", "permission", "route", "outcome", "response"];
    var STAGE_MS = {
      request: 900,
      receive: 700,
      processing: 2400,
      permission: 1000,
      route: 1100,
      outcome: 1300,
      response: 1000
    };
    var PERM_TEXT = {
      permission: "Approve action?",
      route: "Review before applying",
      outcome: "Safe suggestion only"
    };
    var TERM_LINES = {
      request: "User request captured locally.",
      receive: "Steward core received request.",
      processing: "Activating local components...",
      permission: "Permission gate: user confirmation required.",
      route: "Routing to active application only.",
      outcome: "Application outcome panel rendered.",
      response: "Permission-aware response returned to user."
    };

    var tabs = root.querySelectorAll("[data-movie-workflow]");
    var workflows = [];
    tabs.forEach(function (tab) {
      workflows.push(tab.getAttribute("data-movie-workflow"));
    });
    if (!workflows.length) return;

    var processNodes = root.querySelectorAll(".fbi-steward-movie__node[data-steward-node]");
    var pathNodes = root.querySelectorAll(".fbi-steward-movie__path--node[data-route-node]");
    var apps = root.querySelectorAll("[data-movie-app]");
    var requests = root.querySelectorAll("[data-movie-request]");
    var responses = root.querySelectorAll("[data-movie-response]");
    var outcomes = root.querySelectorAll("[data-movie-outcome]");
    var terminal = root.querySelector("[data-movie-terminal]");
    var stageLabel = root.querySelector("[data-movie-stage-label]");
    var permBox = root.querySelector("[data-movie-permission]");
    var permText = root.querySelector("[data-movie-permission-text]");
    var toggleBtn = root.querySelector("[data-movie-toggle]");
    var toggleLabel = root.querySelector("[data-movie-toggle-label]");

    var wfIdx = 0;
    var stageIdx = 0;
    var timer = null;
    var nodeTimer = null;
    var nodeStep = 0;
    var reduced = window.matchMedia("(prefers-reduced-motion: reduce)").matches;
    var paused = root.getAttribute("data-paused") === "true";

    function clearTimers() {
      if (timer) window.clearTimeout(timer);
      if (nodeTimer) window.clearInterval(nodeTimer);
      timer = null;
      nodeTimer = null;
    }

    function clearNodeLights() {
      processNodes.forEach(function (n) {
        n.classList.remove("fbi-steward-movie__node--lit");
      });
      pathNodes.forEach(function (p) {
        p.classList.remove("fbi-steward-movie__path--lit");
      });
    }

    function lightNodeAt(i) {
      if (i < 0 || i >= processNodes.length) return;
      processNodes[i].classList.add("fbi-steward-movie__node--lit");
      var id = processNodes[i].getAttribute("data-steward-node");
      if (id) {
        var path = root.querySelector('.fbi-steward-movie__path--node[data-route-node="' + id + '"]');
        if (path) path.classList.add("fbi-steward-movie__path--lit");
      }
    }

    function runNodeSequence() {
      clearNodeLights();
      nodeStep = 0;
      lightNodeAt(0);
      if (processNodes.length < 2) return;
      nodeTimer = window.setInterval(function () {
        nodeStep += 1;
        if (nodeStep >= processNodes.length) {
          window.clearInterval(nodeTimer);
          nodeTimer = null;
          return;
        }
        lightNodeAt(nodeStep);
      }, 280);
    }

    function appendTerminal(stage) {
      if (!terminal) return;
      var line = document.createElement("li");
      line.textContent = TERM_LINES[stage] || stage;
      terminal.appendChild(line);
      while (terminal.children.length > 6) {
        terminal.removeChild(terminal.firstChild);
      }
    }

    function setWorkflow(id) {
      root.setAttribute("data-workflow", id);
      tabs.forEach(function (tab) {
        var on = tab.getAttribute("data-movie-workflow") === id;
        tab.classList.toggle("fbi-steward-movie__tab--active", on);
        tab.setAttribute("aria-selected", on ? "true" : "false");
      });
      requests.forEach(function (el) {
        el.classList.toggle("fbi-steward-movie__request--active", el.getAttribute("data-movie-request") === id);
      });
      responses.forEach(function (el) {
        el.classList.toggle("fbi-steward-movie__response--active", el.getAttribute("data-movie-response") === id);
      });
      outcomes.forEach(function (el) {
        el.classList.toggle("fbi-steward-movie__outcome--active", el.getAttribute("data-movie-outcome") === id);
      });
      apps.forEach(function (app) {
        app.classList.toggle("fbi-steward-movie__app--active", app.getAttribute("data-movie-app") === id);
      });
    }

    function setStage(stage) {
      root.setAttribute("data-stage", stage);
      root.classList.remove.apply(
        root.classList,
        STAGES.map(function (s) {
          return "fbi-steward-movie--stage-" + s;
        })
      );
      root.classList.add("fbi-steward-movie--stage-" + stage);
      if (stageLabel) stageLabel.textContent = stage;

      if (stage === "processing") {
        runNodeSequence();
      } else if (stage === "response") {
        processNodes.forEach(function (n) {
          n.classList.add("fbi-steward-movie__node--lit");
        });
      } else if (stage !== "route" && stage !== "outcome") {
        clearNodeLights();
      }

      if (permText && permBox) {
        if (stage === "permission" || stage === "route" || stage === "outcome") {
          permText.textContent = PERM_TEXT[stage] || "Approve action?";
          permBox.hidden = false;
        } else if (stage === "request" || stage === "receive") {
          permBox.hidden = true;
        }
      }

      appendTerminal(stage);
    }

    function scheduleNext() {
      clearTimers();
      if (paused || reduced) return;
      var stage = STAGES[stageIdx];
      timer = window.setTimeout(advance, STAGE_MS[stage] || 900);
    }

    function advance() {
      stageIdx += 1;
      if (stageIdx >= STAGES.length) {
        stageIdx = 0;
        if (terminal) terminal.innerHTML = "";
        wfIdx = (wfIdx + 1) % workflows.length;
        setWorkflow(workflows[wfIdx]);
      }
      setStage(STAGES[stageIdx]);
      scheduleNext();
    }

    function resetCycle(workflowId, startStage) {
      clearTimers();
      if (terminal) terminal.innerHTML = "";
      clearNodeLights();
      wfIdx = workflows.indexOf(workflowId);
      if (wfIdx < 0) wfIdx = 0;
      setWorkflow(workflows[wfIdx]);
      stageIdx = STAGES.indexOf(startStage || "request");
      if (stageIdx < 0) stageIdx = 0;
      setStage(STAGES[stageIdx]);
      if (!paused && !reduced) scheduleNext();
    }

    function showReducedFinal() {
      clearTimers();
      setWorkflow(workflows[wfIdx]);
      setStage("response");
      processNodes.forEach(function (n) {
        n.classList.add("fbi-steward-movie__node--lit");
      });
      if (terminal && terminal.children.length === 0) {
        STAGES.forEach(function (s) {
          appendTerminal(s);
        });
      }
      if (permText) permText.textContent = "Review before applying";
      if (permBox) permBox.hidden = false;
    }

    tabs.forEach(function (tab) {
      tab.addEventListener("click", function () {
        var id = tab.getAttribute("data-movie-workflow");
        if (!id) return;
        resetCycle(id, reduced ? "response" : "request");
        if (reduced) showReducedFinal();
      });
    });

    if (toggleBtn) {
      toggleBtn.addEventListener("click", function () {
        paused = !paused;
        root.setAttribute("data-paused", paused ? "true" : "false");
        toggleBtn.setAttribute("aria-pressed", paused ? "true" : "false");
        toggleBtn.setAttribute("aria-label", paused ? "Play animation" : "Pause animation");
        if (toggleLabel) toggleLabel.textContent = paused ? "Play" : "Pause";
        if (paused) {
          clearTimers();
        } else if (!reduced) {
          scheduleNext();
        }
      });
    }

    if (reduced) {
      showReducedFinal();
      return;
    }

    resetCycle(workflows[0], "request");
  })();
</script>