<section class="fbi-steward-train fbi-grid-bg border-y border-slate-200/80 bg-white" aria-labelledby="fbi-steward-train-title">
  <div class="mx-auto max-w-7xl px-4 py-20 sm:px-6 sm:py-28 lg:px-8">
    <div class="mx-auto max-w-3xl text-center">
      <p class="fbi-kicker text-faithGold"><%= SITE.steward.trainabilityKicker %></p>
      <h2 id="fbi-steward-train-title" class="fbi-section-title fbi-section-title--lg mt-3"><%= SITE.steward.trainabilityHeadline %></h2>
      <p class="fbi-section-lead mx-auto"><%= SITE.steward.trainabilityLead %></p>
    </div>

    <div class="fbi-steward-train__grid mt-14 grid gap-6 sm:grid-cols-2 lg:grid-cols-3 lg:gap-8">
      <% SITE.steward.trainabilityFeatures.forEach(function (feat) { %>
      <div class="fbi-steward-train__card fbi-glow-blue">
        <h3 class="text-base font-bold text-navy"><%= feat.title %></h3>
        <p class="mt-2 text-sm leading-relaxed text-slate-600"><%= feat.body %></p>
      </div>
      <% }); %>
    </div>

    <ul class="fbi-steward-train__statements mt-14 grid gap-4 sm:grid-cols-2 lg:grid-cols-3" aria-label="Training principles">
      <% SITE.steward.trainabilityStatements.forEach(function (stmt) { %>
      <li class="fbi-steward-train__statement"><%= stmt %></li>
      <% }); %>
    </ul>

    <blockquote class="fbi-statement fbi-statement--center mt-14 mx-auto max-w-2xl text-center"><%= SITE.steward.trainabilityLine %></blockquote>
  </div>
</section>
