<%
  var p = typeof productId !== "undefined" ? NAV_PRODUCTS.find(function (x) { return x.id === productId; }) : null;
%>
<% if (p) {
  var prod = PRODUCTS[p.id];
  var large = typeof cardLarge !== "undefined" && cardLarge;
  var showMock = typeof cardShowMockup !== "undefined" && cardShowMockup;
  var tagClass = p.id === "sentinel" ? "text-slate-600" : "text-faithGold";
  var badgeClass = p.id === "sentinel" ? "bg-slate-100 text-slate-700 ring-slate-200" : "bg-amber-50 text-amber-800 ring-amber-100";
%>
<article class="fbi-card fbi-card--flat fbi-card--glow group flex flex-col overflow-hidden ring-1 ring-slate-900/[0.03] <%= large ? 'sm:min-h-[22rem]' : '' %>">
  <% if (showMock) { %>
  <div class="border-b border-slate-100 bg-gradient-to-b from-slate-50 to-white p-4">
    <%- include('./tw-ui-mockup', { mockupType: p.id, mockupDark: p.id === 'sentinel', mockupCompact: true }) %>
  </div>
  <% } %>
  <div class="flex flex-1 flex-col p-7 sm:p-8 <%= large ? 'sm:p-9' : '' %>">
    <div class="mb-3 flex flex-wrap items-center justify-between gap-2">
      <span class="text-xs font-bold uppercase tracking-wider <%= tagClass %>"><%= prod.tag %></span>
      <span class="rounded-full px-2.5 py-0.5 text-xs font-semibold ring-1 <%= badgeClass %>"><%= prod.statusBadge || SITE.availability.badge %></span>
    </div>
    <h3 class="<%= large ? 'text-2xl sm:text-3xl' : 'text-xl' %> font-bold text-navy"><%= p.label %></h3>
    <% if (large && prod.headline) { %>
    <p class="mt-2 text-sm font-medium text-slate-500"><%= prod.headline %></p>
    <% } %>
    <p class="mt-3 flex-1 text-sm leading-relaxed text-slate-600"><%= large ? prod.subhead : prod.cardBlurb %></p>
    <a href="<%= p.href %>" class="mt-6 inline-flex text-sm font-semibold text-navy underline-offset-4 transition duration-200 group-hover:text-faithGold hover:underline focus:outline-none focus-visible:ring-2 focus-visible:ring-faithGold focus-visible:ring-offset-2 rounded-sm"><%= large ? 'View product page' : 'Learn more' %> →</a>
  </div>
</article>
<% } %>
