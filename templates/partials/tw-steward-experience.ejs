<section class="fbi-steward-cinema fbi-ambient fbi-ambient--shift" aria-labelledby="fbi-steward-cinema-title">
  <div class="fbi-steward-cinema__grid-texture pointer-events-none absolute inset-0" aria-hidden="true"></div>
  <div class="fbi-steward-cinema__glow pointer-events-none absolute inset-0" aria-hidden="true"></div>
  <div class="fbi-steward-cinema__float fbi-steward-cinema__float--a pointer-events-none" aria-hidden="true"></div>
  <div class="fbi-steward-cinema__float fbi-steward-cinema__float--b pointer-events-none" aria-hidden="true"></div>

  <div class="fbi-ambient__inner relative mx-auto max-w-7xl px-4 py-20 sm:px-6 sm:py-28 lg:px-8">
    <div class="mx-auto max-w-3xl text-center">
      <p class="fbi-kicker text-amber-200/90"><%= SITE.steward.cinemaKicker %></p>
      <h2 id="fbi-steward-cinema-title" class="fbi-section-title fbi-section-title--xl mt-3 text-white"><%= SITE.steward.cinemaHeadline %></h2>
      <p class="fbi-section-lead mx-auto text-slate-300"><%= SITE.steward.cinemaLead %></p>
    </div>

    <div class="fbi-steward-flow mt-14 lg:mt-16" role="img" aria-label="<%= SITE.steward.flowAriaLabel %>">
      <svg class="fbi-steward-flow__lines" viewBox="0 0 960 640" preserveAspectRatio="xMidYMid meet" aria-hidden="true">
        <defs>
          <linearGradient id="fbi-flow-grad-blue" x1="0%" y1="0%" x2="100%" y2="0%">
            <stop offset="0%" stop-color="rgba(148,163,184,0)" />
            <stop offset="50%" stop-color="rgba(148,163,184,0.55)" />
            <stop offset="100%" stop-color="rgba(148,163,184,0)" />
          </linearGradient>
          <linearGradient id="fbi-flow-grad-gold" x1="0%" y1="0%" x2="100%" y2="100%">
            <stop offset="0%" stop-color="rgba(217,119,6,0.15)" />
            <stop offset="50%" stop-color="rgba(217,119,6,0.65)" />
            <stop offset="100%" stop-color="rgba(217,119,6,0.15)" />
          </linearGradient>
        </defs>
        <path class="fbi-steward-flow__path fbi-steward-flow__path--user" d="M120 120 L480 280" />
        <path class="fbi-steward-flow__path fbi-steward-flow__path--cfo" d="M480 280 L780 100" />
        <path class="fbi-steward-flow__path fbi-steward-flow__path--sentinel" d="M480 280 L820 280" />
        <path class="fbi-steward-flow__path fbi-steward-flow__path--eden" d="M480 280 L780 460" />
        <path class="fbi-steward-flow__path fbi-steward-flow__path--ledger" d="M480 280 L140 460" />
        <path class="fbi-steward-flow__path fbi-steward-flow__path--vault" d="M480 280 L480 520" />
        <circle class="fbi-steward-flow__pulse" cx="480" cy="280" r="64" />
      </svg>

      <div class="fbi-steward-flow__user">
        <div class="fbi-steward-flow__panel fbi-steward-flow__panel--user">
          <span class="fbi-steward-flow__chip">You</span>
          <div class="fbi-steward-flow__requests" aria-live="polite">
            <% SITE.steward.exampleRequests.forEach(function (req, i) { %>
            <p class="fbi-steward-flow__request<%= i === 0 ? ' fbi-steward-flow__request--active' : '' %>" data-request-index="<%= i %>"><%= req %></p>
            <% }); %>
          </div>
        </div>
      </div>

      <div class="fbi-steward-flow__core">
        <div class="fbi-steward-flow__core-ring" aria-hidden="true"></div>
        <div class="fbi-steward-flow__panel fbi-steward-flow__panel--core">
          <span class="fbi-steward-flow__chip fbi-steward-flow__chip--gold"><%= SITE.steward.name %></span>
          <p class="fbi-steward-flow__core-title">Operational guidance layer</p>
          <div class="fbi-steward-flow__nodes" role="list">
            <% SITE.steward.processNodes.forEach(function (node) { %>
            <button type="button" class="fbi-steward-flow__node" data-steward-node="<%= node.id %>" role="listitem" aria-describedby="fbi-node-desc-<%= node.id %>">
              <span class="fbi-steward-flow__node-dot" aria-hidden="true"></span>
              <span class="fbi-steward-flow__node-label"><%= node.label %></span>
            </button>
            <% }); %>
          </div>
          <p class="fbi-steward-flow__core-hint">Rules · memory · permissions · vault · context · tools</p>
        </div>
      </div>

      <div class="fbi-steward-flow__apps">
        <div class="fbi-steward-flow__app fbi-steward-flow__app--cfo" data-app="cfo">
          <div class="fbi-steward-flow__panel fbi-steward-flow__panel--app">
            <span class="fbi-steward-flow__app-tag">CFO</span>
            <p class="fbi-steward-flow__app-meta">Finance command</p>
          </div>
        </div>
        <div class="fbi-steward-flow__app fbi-steward-flow__app--sentinel" data-app="sentinel">
          <div class="fbi-steward-flow__panel fbi-steward-flow__panel--app">
            <span class="fbi-steward-flow__app-tag">Sentinel</span>
            <p class="fbi-steward-flow__app-meta">Evidence workspace</p>
          </div>
        </div>
        <div class="fbi-steward-flow__app fbi-steward-flow__app--eden" data-app="eden">
          <div class="fbi-steward-flow__panel fbi-steward-flow__panel--app">
            <span class="fbi-steward-flow__app-tag">Eden</span>
            <p class="fbi-steward-flow__app-meta">Research workspace</p>
          </div>
        </div>
        <div class="fbi-steward-flow__app fbi-steward-flow__app--ledger" data-app="ledger">
          <div class="fbi-steward-flow__panel fbi-steward-flow__panel--app">
            <span class="fbi-steward-flow__app-tag">Ledger</span>
            <p class="fbi-steward-flow__app-meta">Identity vault</p>
          </div>
        </div>
      </div>

      <div class="fbi-steward-flow__vault">
        <div class="fbi-steward-flow__panel fbi-steward-flow__panel--vault">
          <span class="fbi-steward-flow__chip">Local foundation</span>
          <p class="fbi-steward-flow__vault-title">Vault · Rules · Memory · Tools</p>
          <p class="fbi-steward-flow__vault-meta">On your machine. Resettable. Yours.</p>
        </div>
      </div>

      <div class="fbi-steward-flow__response">
        <div class="fbi-steward-flow__panel fbi-steward-flow__panel--response">
          <span class="fbi-steward-flow__chip fbi-steward-flow__chip--muted">Response</span>
          <ul class="fbi-steward-flow__response-list">
            <% SITE.steward.responseItems.forEach(function (item) { %>
            <li><span class="fbi-steward-flow__response-dot" aria-hidden="true"></span><%= item %></li>
            <% }); %>
          </ul>
        </div>
      </div>

      <p class="fbi-steward-flow__caption">User request → <%= SITE.steward.name %> → separate apps → local vault and rules · concept preview</p>
    </div>

    <ul class="fbi-steward-cinema__telemetry mt-10 flex flex-wrap justify-center gap-2 sm:gap-3" aria-label="Steward characteristics">
      <% SITE.steward.cinemaChips.forEach(function (chip) { %>
      <li class="fbi-steward-cinema__tel"><%= chip %></li>
      <% }); %>
    </ul>
  </div>
</section>
