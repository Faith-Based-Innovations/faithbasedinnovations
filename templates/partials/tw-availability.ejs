<section class="fbi-status-band" aria-label="Product availability">
  <div class="mx-auto max-w-4xl px-4 py-14 text-center sm:px-6 lg:px-8">
    <p class="text-xs font-bold uppercase tracking-[0.2em] text-amber-900"><%= SITE.availability.badge %></p>
    <p class="mt-4 text-base leading-relaxed text-slate-700"><%= SITE.availability.line %></p>
    <p class="mt-2 text-sm font-semibold text-navy" role="status"><%= SITE.availability.ctaLabel %></p>
  </div>
</section>
