<%
  var mType = typeof mockupType !== "undefined" ? mockupType : "generic";
  var mDark = typeof mockupDark !== "undefined" ? mockupDark : false;
  var panelClass = "fbi-panel-ui fbi-glow-blue " + (mDark ? "fbi-panel-ui--dark" : "");
%>
<div class="<%= panelClass %>" role="img" aria-label="Illustrative product interface">
  <div class="fbi-panel-ui__chrome">
    <span class="fbi-panel-ui__dot fbi-panel-ui__dot--gold" aria-hidden="true"></span>
    <span class="fbi-panel-ui__dot" aria-hidden="true"></span>
    <span class="fbi-panel-ui__dot" aria-hidden="true"></span>
    <span class="ml-2 text-[10px] font-semibold uppercase tracking-[0.14em] <%= mDark ? 'text-slate-400' : 'text-slate-500' %>"><%= mType === 'steward' ? SITE.steward.name : (mType.charAt(0).toUpperCase() + mType.slice(1)) %></span>
  </div>
  <div class="p-5 sm:p-6">
    <% if (mType === 'cfo') { %>
    <div class="flex items-start justify-between gap-3">
      <div>
        <p class="text-[10px] font-bold uppercase tracking-[0.16em] text-faithGold">Cash outlook</p>
        <p class="mt-1 text-2xl font-bold <%= mDark ? 'text-white' : 'text-navy' %>">$24,180</p>
        <p class="mt-0.5 text-xs <%= mDark ? 'text-slate-400' : 'text-slate-500' %>">Runway · 14 mo (modeled)</p>
      </div>
      <span class="rounded-md border border-faithGold/30 bg-amber-50/80 px-2 py-1 text-[10px] font-semibold text-amber-900">Local</span>
    </div>
    <div class="mt-5 fbi-ui-bar" aria-hidden="true"><span></span><span></span><span></span><span></span><span></span><span></span></div>
    <div class="mt-5 space-y-2">
      <div class="flex items-center justify-between rounded-lg border <%= mDark ? 'border-slate-600/60 bg-slate-800/50' : 'border-slate-200 bg-white' %> px-3 py-2 text-xs">
        <span class="<%= mDark ? 'text-slate-300' : 'text-slate-600' %>">Operating account</span>
        <span class="font-semibold <%= mDark ? 'text-white' : 'text-navy' %>">$8,420</span>
      </div>
      <div class="flex items-center justify-between rounded-lg border <%= mDark ? 'border-slate-600/60 bg-slate-800/50' : 'border-slate-200 bg-white' %> px-3 py-2 text-xs">
        <span class="<%= mDark ? 'text-slate-300' : 'text-slate-600' %>">Recurring · due Fri</span>
        <span class="font-semibold text-faithGold">-$240</span>
      </div>
    </div>
    <% } else if (mType === 'sentinel') { %>
    <p class="text-[10px] font-bold uppercase tracking-[0.16em] text-slate-400">Timeline · Case overview</p>
    <div class="mt-4 flex items-center gap-2">
      <% [1,2,3,4,5].forEach(function (n) { %>
      <div class="flex flex-1 flex-col items-center gap-1">
        <span class="h-2 w-2 rounded-full <%= n === 3 ? 'bg-faithGold shadow-[0_0_0_4px_rgba(217,119,6,0.2)]' : 'bg-slate-500' %>"></span>
        <span class="h-px w-full bg-gradient-to-r from-slate-600 to-transparent <%= n === 5 ? 'opacity-0' : '' %>"></span>
      </div>
      <% }); %>
    </div>
    <div class="mt-5 grid grid-cols-2 gap-2 text-[10px]">
      <div class="rounded-lg border border-slate-600/50 bg-slate-800/60 p-2.5">
        <p class="font-semibold text-slate-300">Evidence</p>
        <p class="mt-1 text-slate-400">142 items linked</p>
      </div>
      <div class="rounded-lg border border-faithGold/30 bg-amber-950/30 p-2.5">
        <p class="font-semibold text-amber-200">Export packet</p>
        <p class="mt-1 text-slate-400">Ready for review</p>
      </div>
    </div>
    <% } else if (mType === 'eden') { %>
    <p class="text-[10px] font-bold uppercase tracking-[0.16em] text-faithGold">Source stack</p>
    <ul class="mt-3 space-y-2 text-xs">
      <li class="flex items-center gap-2 rounded-lg border <%= mDark ? 'border-slate-600/50 bg-slate-800/40' : 'border-slate-200 bg-slate-50' %> px-3 py-2">
        <span class="h-1.5 w-1.5 rounded-full bg-faithGold"></span>
        <span class="<%= mDark ? 'text-slate-200' : 'text-navy' %>">Claim · corroborated</span>
        <span class="ml-auto text-[10px] text-emerald-600">High</span>
      </li>
      <li class="flex items-center gap-2 rounded-lg border <%= mDark ? 'border-slate-600/50 bg-slate-800/40' : 'border-slate-200 bg-white' %> px-3 py-2">
        <span class="h-1.5 w-1.5 rounded-full bg-slate-400"></span>
        <span class="<%= mDark ? 'text-slate-300' : 'text-slate-600' %>">Article · pending cite</span>
      </li>
      <li class="flex items-center gap-2 rounded-lg border <%= mDark ? 'border-slate-600/50 bg-slate-800/40' : 'border-slate-200 bg-white' %> px-3 py-2">
        <span class="h-1.5 w-1.5 rounded-full bg-slate-400"></span>
        <span class="<%= mDark ? 'text-slate-300' : 'text-slate-600' %>">Recording · transcribed</span>
      </li>
    </ul>
    <% } else if (mType === 'ledger') { %>
    <div class="flex items-center gap-3">
      <div class="flex h-10 w-10 items-center justify-center rounded-xl border-2 border-faithGold/40 bg-amber-50/10">
        <svg class="h-5 w-5 text-faithGold" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="1.75" aria-hidden="true"><path d="M12 15v2m-6 4h12a2 2 0 002-2v-6a2 2 0 00-2-2H6a2 2 0 00-2 2v6a2 2 0 002 2zm10-10V7a4 4 0 00-8 0v4h8z" stroke-linecap="round" stroke-linejoin="round"/></svg>
      </div>
      <div>
        <p class="text-[10px] font-bold uppercase tracking-[0.14em] text-faithGold">Encrypted vault</p>
        <p class="text-sm font-semibold <%= mDark ? 'text-white' : 'text-navy' %>">2 profiles · local only</p>
      </div>
    </div>
    <div class="mt-5 space-y-2 text-xs">
      <div class="flex justify-between rounded-md border border-dashed <%= mDark ? 'border-slate-500 bg-slate-800/30' : 'border-slate-300 bg-white' %> px-3 py-2">
        <span class="<%= mDark ? 'text-slate-400' : 'text-slate-500' %>">Form field · SSN</span>
        <span class="font-mono text-faithGold">•••-••-1234</span>
      </div>
      <div class="flex justify-between rounded-md border <%= mDark ? 'border-slate-600/50' : 'border-slate-200' %> px-3 py-2">
        <span class="<%= mDark ? 'text-slate-400' : 'text-slate-500' %>">Address line 1</span>
        <span class="<%= mDark ? 'text-slate-200' : 'text-navy' %>">Exact match</span>
      </div>
      <div class="flex justify-between rounded-md border border-amber-200/50 bg-amber-50/50 px-3 py-2">
        <span class="text-slate-500">Missing field</span>
        <span class="text-amber-800">Left empty</span>
      </div>
    </div>
    <% } else if (mType === 'steward') { %>
    <div class="flex items-center justify-between gap-4 border-b <%= mDark ? 'border-slate-600/50' : 'border-slate-200' %> pb-4">
      <h2 class="text-xs font-bold uppercase tracking-[0.24em] text-amber-600"><%= SITE.steward.name %></h2>
      <span class="shrink-0 rounded-full border <%= mDark ? 'border-slate-500 text-slate-300' : 'border-slate-300 text-slate-600' %> px-2.5 py-0.5 text-[10px] font-medium"><%= SITE.availability.badge %></span>
    </div>
    <p class="mt-4 text-sm leading-relaxed <%= mDark ? 'text-slate-300' : 'text-slate-600' %>"><%= SITE.steward.short %></p>
    <p class="mt-6 text-[10px] font-semibold uppercase tracking-[0.18em] <%= mDark ? 'text-slate-500' : 'text-slate-400' %>">Product line</p>
    <p class="mt-2 text-sm font-medium <%= mDark ? 'text-slate-100' : 'text-navy' %>">Sentinel · CFO · Eden · Ledger</p>
    <% } else { %>
    <p class="text-sm <%= mDark ? 'text-slate-300' : 'text-slate-600' %>">Structured desktop software on your machine.</p>
    <% } %>
  </div>
</div>
